---
// docs/design-spec.md §8, §10. Shared head, skip link, header and footer for
// every page.
import '../styles/global.css';
import hankenWoff2 from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import jetbrainsWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import headInline from '../scripts/head-inline.js?raw';
import vtInline from '../scripts/vt.ts?raw';
import SkipLink from '../components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { getCollection } from 'astro:content';
import { site as facts, home } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  current?: 'work' | 'about' | 'contact';
  currentSlug?: string;
}
const { title, description, ogImage = '/og-default.png', ogType = 'website', noindex = false, current, currentSlug } = Astro.props;

const site = Astro.site ?? new URL('https://adrieltang.vercel.app');
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL(ogImage, site);
const allWork = await getCollection('work');

// Structured data: who Adriel is and the freelance service. Every value comes
// from src/data/site.ts or the configured `site` URL; nothing is invented here.
const origin = new URL('/', site).href;
const sameAs = [facts.github, facts.linkedin];
const address = { '@type': 'PostalAddress', addressLocality: facts.city, addressCountry: facts.country };
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${origin}#person`,
      name: facts.name,
      url: origin,
      email: `mailto:${facts.email}`,
      jobTitle: 'Full stack developer',
      knowsAbout: [
        'ASP.NET Core',
        'C#',
        'REST APIs',
        'Database design',
        'SQL',
        'Flutter',
        'Dart',
        'Web application development',
        'Mobile app development',
      ],
      address,
      sameAs,
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${origin}#service`,
      name: facts.name,
      description: home.description,
      url: origin,
      email: `mailto:${facts.email}`,
      image: new URL('/og-default.png', site).href,
      address,
      areaServed: { '@type': 'Country', name: 'Malaysia' },
      founder: { '@id': `${origin}#person` },
      sameAs,
    },
  ],
};
// Escape `<` so no string value can close the script element early.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#F4F5F6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E0F11" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" type="image/png" />

    <link rel="preload" as="font" type="font/woff2" href={hankenWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jetbrainsWoff2} crossorigin />

    <script is:inline type="application/ld+json" set:html={jsonLdText} />
    <script is:inline set:html={headInline} />
    <script is:inline set:html={vtInline} />
  </head>
  <body>
    <SkipLink />
    <SiteHeader current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter projects={allWork} currentSlug={currentSlug} />
    <CommandPalette />
  </body>
</html>
