---
// docs/design-spec.md §5.5.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortByOrder } from '../lib/work';
const work = sortByOrder(await getCollection('work'));
---
<BaseLayout title="Page Not Found: Adriel Tang" description="This page doesn't exist. Head back to Adriel Tang's homepage for recent projects and contact details." noindex>
  <div class="container not-found">
    <h1 class="display">Page not found.</h1>
    <p>
      That page doesn't exist. Head back to the <a href="/">homepage</a> or the <a href="/#work">work list</a>.
    </p>
    <p class="path" id="not-found-path"></p>
    <ul class="links">
      {work.map((p) => (
        <li><a href={`/work/${p.id}/`}>{p.data.title}<span class="scope">{p.data.scope}, {p.data.year}</span></a></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<script>
  const el = document.getElementById('not-found-path');
  if (el && location.pathname) el.textContent = location.pathname;
</script>

<style>
  .not-found {
    padding-block: 96px;
  }
  h1 {
    font-size: var(--step-6);
    line-height: 0.84;
    text-transform: uppercase;
    color: var(--c-display);
    max-width: 8ch;
  }
  p {
    font-size: var(--step-2);
    margin-top: 16px;
    max-width: 50ch;
  }
  .links {
    list-style: none;
    margin-top: var(--space-8);
    max-width: 50ch;
    border-top: 1px solid var(--c-rule);
  }
  .links li {
    border-bottom: 1px solid var(--c-rule);
  }
  .links a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    min-height: 44px;
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }
  .scope {
    font-family: var(--font-data);
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--c-ink-2);
  }
  .path {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
</style>
