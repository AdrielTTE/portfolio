---
// About: name and bio beside the photo, then background, skills, music and
// the Lately log (moved here from the home page). The hire moment is the
// espresso footer, so this page has no CTA block of its own.
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import SkillGroups from '../components/SkillGroups.astro';
import { getCollection } from 'astro:content';
import photo from '../assets/tempProfile.jpg';
import { heroRoleLine, bio, timeline, skills, musicParagraph, photoAlt } from '../data/about';
import { toLatelyLine, newestFirst } from '../lib/lately';

const lately = newestFirst((await getCollection('lately')).map((e) => e.data)).map(toLatelyLine);
---
<BaseLayout
  title="About Adriel Tang: ASP.NET and Flutter Developer in Kuala Lumpur"
  description="Background, timeline, and skills for Adriel Tang, a full stack developer in Kuala Lumpur working in ASP.NET Core and Flutter, with a BIT (Honours) from TAR UMT."
  current="about"
>
  <div class="container about-layout">
    <div class="top-text">
      <h1 class="display">Adriel Tang Thien Ern</h1>
      <p class="role-line">{heroRoleLine}</p>
      <div class="bio">
        <p class="bio-1">{bio[0]}</p>
        <p class="bio-2">{bio[1]}</p>
      </div>
    </div>

    <div class="photo-col">
      <Picture
        src={photo}
        alt={photoAlt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 30vw, 100vw"
        loading="eager"
        class="photo"
      />
    </div>

    <div class="lower-content">
      <section data-reveal aria-labelledby="edu-h">
        <h2 id="edu-h" class="display">Education and work</h2>
        <Timeline items={timeline} />
      </section>

      <section data-reveal aria-labelledby="skills-h">
        <h2 id="skills-h" class="display">Skills</h2>
        <SkillGroups groups={skills} />
      </section>

      <section class="music-section" data-reveal aria-labelledby="music-h">
        <h2 id="music-h" class="display">Sound and music</h2>
        <p>{musicParagraph}</p>
      </section>

      <section id="log" data-reveal aria-labelledby="log-h">
        <h2 id="log-h" class="display">Lately</h2>
        <ol class="lately">
          {lately.map((l) => (
            <li>
              <time datetime={l.iso}>{l.label}</time>
              <span>{l.text}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>
</BaseLayout>

<script src="../scripts/reveal-sections.ts"></script>

<style>
  .about-layout {
    padding-top: clamp(var(--space-5), 2.5vw + 16px, var(--space-8));
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: 'top' 'photo' 'lower';
    row-gap: var(--space-7);
  }
  .top-text {
    grid-area: top;
  }
  .photo-col {
    grid-area: photo;
  }
  .lower-content {
    grid-area: lower;
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-8), 4vw + 24px, var(--space-9));
  }
  .photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 45% 35%;
  }
  h1 {
    font-size: var(--step-6);
    line-height: 0.84;
    text-transform: uppercase;
    color: var(--c-display);
    max-width: 9ch;
  }
  .role-line {
    font-size: var(--step-2);
    font-weight: 500;
    margin-top: var(--space-5);
  }
  .bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
    max-width: 58ch;
  }
  .bio-1 {
    font-size: var(--step-2);
    line-height: 1.4;
  }
  .bio-2 {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--c-ink-2);
  }
  h2 {
    font-size: var(--step-4);
    margin-bottom: var(--space-5);
  }
  .music-section p {
    font-size: var(--step-2);
    line-height: 1.4;
    max-width: 44ch;
  }
  .lately {
    list-style: none;
    display: grid;
    gap: var(--space-4);
    max-width: 62ch;
  }
  .lately li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-4);
  }
  .lately time {
    color: var(--c-ink-2);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 479px) {
    .lately li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .photo-col {
      width: 62.5%;
    }
  }
  @media (min-width: 1024px) {
    .about-layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas: none;
      column-gap: var(--gutter);
      row-gap: var(--space-9);
    }
    .top-text {
      grid-area: auto;
      grid-column: 5 / span 8;
      grid-row: 1;
    }
    .photo-col {
      grid-area: auto;
      grid-column: 1 / span 3;
      grid-row: 1 / span 2;
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      align-self: start;
    }
    .lower-content {
      grid-area: auto;
      grid-column: 5 / span 8;
      grid-row: 2;
    }
  }
</style>
