---
// docs/design-spec.md §5.4.
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmail from '../components/CopyEmail.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, whatsappUrl, projectSteps } from '../data/site';
---
<BaseLayout
  title="Contact: Adriel Tang"
  description="Get in touch with Adriel Tang about a web app, backend API, database or Flutter mobile app. Email, WhatsApp, LinkedIn, or the contact form."
  current="contact"
>
  <div class="container contact-layout">
    <div class="contact-info">
      <h1>Contact</h1>
      <p class="intro">Tell me about the web app, API, or mobile app you need. Reach out by email, WhatsApp, or the form below.</p>
      <p class="email-row">
        <a class="email-link breakable" href={`mailto:${site.email}`}>{site.email}</a>
        <CopyEmail email={site.email} />
      </p>
      <ul class="links-list">
        <li><a href={site.github} rel="noopener" target="_blank">GitHub <span class="arrow">↗</span></a></li>
        <li><a href={site.linkedin} rel="noopener" target="_blank">LinkedIn <span class="arrow">↗</span></a></li>
        <li><a href={whatsappUrl()} rel="noopener" target="_blank">Message on WhatsApp <span class="arrow">↗</span></a></li>
      </ul>
      <section class="next-steps" aria-labelledby="next-h">
        <h2 id="next-h">What happens next</h2>
        <ol role="list">
          {projectSteps.map((step) => <li>{step}</li>)}
        </ol>
      </section>
    </div>
    <div class="contact-form-col" data-reveal>
      <h2>Or send a message</h2>
      <p class="reply-time">{site.replyTime}</p>
      <ContactForm endpoint={site.formspreeEndpoint} subject="Portfolio contact" />
    </div>
  </div>
</BaseLayout>

<script src="../scripts/reveal-sections.ts"></script>

<style>
  .contact-layout {
    padding-block: 32px;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 500;
  }
  .intro {
    font-size: var(--step-2);
    margin-top: 12px;
  }
  .email-row {
    display: flex;
    align-items: center;
    margin-top: 32px;
  }
  .email-link {
    font-weight: 500;
    font-size: var(--step-3);
    text-decoration: none;
  }
  .email-link:hover {
    text-decoration: underline;
  }
  .links-list {
    list-style: none;
    margin-top: 24px;
  }
  .links-list li {
    border-top: 1px solid var(--c-rule);
    min-height: 56px;
    display: flex;
    align-items: center;
    font-size: var(--step-2);
  }
  .links-list a {
    text-decoration: none;
    display: flex;
    align-items: center;
    min-height: 44px;
    flex: 1;
  }
  .links-list a:hover {
    text-decoration: underline;
  }
  .contact-form-col h2 {
    font-size: var(--step-2);
    font-weight: 500;
  }
  .reply-time {
    margin: 8px 0 24px;
    color: var(--c-ink-2);
  }
  /* Three plain lines between rules, matching the links list; the order is
     carried by the <ol> semantics, not by drawn numbers. */
  .next-steps {
    margin-top: 48px;
  }
  .next-steps h2 {
    font-size: var(--step-1);
    font-weight: 600;
    margin-bottom: 12px;
  }
  .next-steps ol {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 52ch;
  }
  .next-steps li {
    border-top: 1px solid var(--c-rule);
    padding-block: 12px;
  }

  @media (min-width: 1024px) {
    .contact-layout {
      flex-direction: row;
      padding-block: 48px;
    }
    .contact-info {
      flex: 0 0 calc((100% - 5 * var(--gutter)) * 6 / 12 + var(--gutter));
    }
    .contact-form-col {
      flex: 1;
    }
  }
</style>
