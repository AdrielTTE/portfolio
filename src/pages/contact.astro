---
// Contact: how to reach me and what happens next on the left, the form on the
// right. The footer drops its hire block on this page (it would repeat it).
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmail from '../components/CopyEmail.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, whatsappUrl, projectSteps } from '../data/site';
---
<BaseLayout
  title="Contact: Adriel Tang"
  description="Get in touch with Adriel Tang about a web app, backend API, database or Flutter mobile app. Email, WhatsApp, LinkedIn, or the contact form."
  current="contact"
>
  <div class="container contact-layout">
    <div class="contact-info">
      <h1 class="display">Contact</h1>
      <p class="intro">Tell me about the web app, API, or mobile app you need. Reach out by email, WhatsApp, or the form.</p>
      <p class="email-row">
        <a class="email-link breakable" href={`mailto:${site.email}`}>{site.email}</a>
        <CopyEmail email={site.email} />
      </p>
      <ul class="links-list">
        <li><a href={whatsappUrl()} rel="noopener" target="_blank">WhatsApp <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a></li>
        <li><a href={site.linkedin} rel="noopener" target="_blank">LinkedIn <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a></li>
        <li><a href={site.github} rel="noopener" target="_blank">GitHub <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a></li>
      </ul>
      <section class="next-steps" aria-labelledby="next-h">
        <h2 id="next-h">What happens next</h2>
        <ol role="list">
          {projectSteps.map((step) => <li>{step}</li>)}
        </ol>
      </section>
    </div>
    <div class="contact-form-col" data-reveal>
      <h2>Send a message</h2>
      <p class="reply-time">{site.replyTime}</p>
      <ContactForm endpoint={site.formspreeEndpoint} subject="Portfolio contact" />
    </div>
  </div>
</BaseLayout>

<script src="../scripts/reveal-sections.ts"></script>

<style>
  .contact-layout {
    padding-top: clamp(var(--space-5), 2.5vw + 16px, var(--space-8));
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
  }
  h1 {
    font-size: var(--step-6);
    line-height: 0.84;
    text-transform: uppercase;
    color: var(--c-display);
  }
  .intro {
    font-size: var(--step-2);
    line-height: 1.35;
    margin-top: var(--space-5);
    max-width: 30ch;
  }
  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) 0;
    margin-top: var(--space-7);
  }
  .email-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    font-size: var(--step-3);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .links-list {
    list-style: none;
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
  }
  .links-list a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: var(--step-1);
    font-weight: 500;
  }
  .contact-form-col h2,
  .next-steps h2 {
    font-size: var(--step-2);
    font-weight: 700;
  }
  .reply-time {
    margin: var(--space-2) 0 var(--space-5);
    color: var(--c-ink-2);
  }
  /* Order is carried by the <ol> semantics, not by drawn numbers. */
  .next-steps {
    margin-top: var(--space-8);
  }
  .next-steps ol {
    list-style: none;
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-3);
    max-width: 48ch;
    color: var(--c-ink-2);
  }

  @media (min-width: 1024px) {
    .contact-layout {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .contact-info {
      grid-column: 1 / span 6;
    }
    .contact-form-col {
      grid-column: 8 / span 5;
      padding-top: var(--space-4);
    }
  }
</style>
