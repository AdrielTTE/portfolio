---
// docs/design-spec.md §5.4.
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmail from '../components/CopyEmail.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, whatsappUrl } from '../data/site';
---
<BaseLayout
  title="Contact: Adriel Tang"
  description="Get in touch with Adriel Tang, a full stack developer in Kuala Lumpur. Email, WhatsApp, LinkedIn, or send a message through the contact form."
  current="contact"
>
  <div class="container contact-layout">
    <div class="contact-info">
      <h1>Contact</h1>
      <p class="intro">Reach out by email, WhatsApp, or the form below.</p>
      <p class="email-row">
        <a class="email-link breakable" href={`mailto:${site.email}`}>{site.email}</a>
        <CopyEmail email={site.email} />
      </p>
      <ul class="links-list">
        <li><a href={site.github} rel="noopener" target="_blank">GitHub <span class="arrow">↗</span></a></li>
        <li><a href={site.linkedin} rel="noopener" target="_blank">LinkedIn <span class="arrow">↗</span></a></li>
        <li><a href={whatsappUrl()} rel="noopener" target="_blank">Message on WhatsApp <span class="arrow">↗</span></a></li>
      </ul>
    </div>
    <div class="contact-form-col" data-reveal>
      <h2>Or send a message</h2>
      <ContactForm endpoint={site.formspreeEndpoint} subject="Portfolio contact" />
    </div>
  </div>
</BaseLayout>

<script src="../scripts/reveal-sections.ts"></script>

<style>
  .contact-layout {
    padding-block: 32px;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 500;
  }
  .intro {
    font-size: var(--step-2);
    margin-top: 12px;
  }
  .email-row {
    display: flex;
    align-items: center;
    margin-top: 32px;
  }
  .email-link {
    font-weight: 500;
    font-size: var(--step-3);
    text-decoration: none;
  }
  .email-link:hover {
    text-decoration: underline;
  }
  .links-list {
    list-style: none;
    margin-top: 24px;
  }
  .links-list li {
    border-top: 1px solid var(--c-rule);
    min-height: 56px;
    display: flex;
    align-items: center;
    font-size: var(--step-2);
  }
  .links-list a {
    text-decoration: none;
  }
  .links-list a:hover {
    text-decoration: underline;
  }
  .contact-form-col h2 {
    font-size: var(--step-2);
    font-weight: 500;
    margin-bottom: 24px;
  }

  @media (min-width: 1024px) {
    .contact-layout {
      flex-direction: row;
      padding-block: 48px;
    }
    .contact-info {
      flex: 0 0 calc((100% - 5 * var(--gutter)) * 6 / 12 + var(--gutter));
    }
    .contact-form-col {
      flex: 1;
    }
  }
</style>
