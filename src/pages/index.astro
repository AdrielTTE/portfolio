---
// Home: masthead → work → what I build. The hire moment is the saffron
// footer (SiteFooter), so the page itself stays three calm parts.
// Borrowed: the full-width condensed masthead from henry.codes; the quiet
// two-column "who / what" under it from frankchimero.com's index (name on
// the left, content on the right); scale and whitespace instead of rules.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkList from '../components/WorkList.astro';
import MagneticLink from '../components/MagneticLink.astro';
import { site, home, offerCopy } from '../data/site';
import { offersWithProjects } from '../lib/offers';

const allWork = await getCollection('work');
const offers = offersWithProjects(allWork);
---
<BaseLayout title={home.title} description={home.description}>
  <div class="container home">
    <section class="intro" aria-labelledby="intro-h">
      <h1 id="intro-h" class="masthead display">
        <span class="line-mask"><span style="--i:0">Adriel</span></span>
        <span class="line-mask"><span style="--i:1">Tang</span></span>
      </h1>
      <div class="under">
        <div class="who line-rise" style="--i:2">
          <p>{home.roleLine}</p>
          <p class="aside">{home.aside}</p>
        </div>
        <div class="what">
          <p class="pitch line-rise" style="--i:3">{home.pitch}</p>
          <div class="actions line-rise" style="--i:4">
            <MagneticLink href="/contact/">Start a project</MagneticLink>
            <p class="avail">{site.availability}</p>
          </div>
        </div>
      </div>
    </section>

    <div class="block" data-reveal><WorkList projects={allWork} /></div>

    {/* What I build: a plain statement, not a widget. Each line names the
        tools and links the projects that show it. */}
    <section class="block build" aria-labelledby="build-h" data-reveal>
      <h2 id="build-h" class="display">What I build</h2>
      <div class="build-body">
        {offers.map((o) => (
          <p>
            {offerCopy[o.id].line}{' '}
            <span class="how">
              {offerCopy[o.id].stack.join(', ')}. See{' '}
              {o.projects.map((p, i) => (
                <>
                  {i > 0 && (i === o.projects.length - 1 ? ' and ' : ', ')}
                  <a href={`/work/${p.id}/`}>{p.data.title}</a>
                </>
              ))}.
            </span>
          </p>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script src="../scripts/reveal-sections.ts"></script>

<style>
  .intro {
    padding-top: clamp(var(--space-5), 2.5vw + 16px, var(--space-8));
  }

  /* The masthead: two stacked words on phones, one line across the full
     measure from 600px. Sized off the viewport so it always fills, never
     overflows. */
  /* Measured: at 68% width "ADRIEL" sets 2.69em wide and "ADRIEL TANG"
     (with the 0.18em gap) 4.88em, so these factors fill the measure with
     a hair to spare. Recheck them if the face, width or copy changes. */
  .masthead {
    font-size: calc((100vw - 2 * var(--margin)) * 0.36);
    line-height: 0.8;
    letter-spacing: -0.02em;
    color: var(--c-display);
    text-transform: uppercase;
  }
  .masthead > .line-mask {
    display: block;
  }
  /* The rise-in mask would clip the tails of the condensed caps' baseline
     overshoot; a little bottom padding keeps them whole. */
  .masthead :global(.line-mask) {
    padding-bottom: 0.04em;
  }
  @media (min-width: 600px) {
    .masthead {
      font-size: calc((100vw - 2 * var(--margin)) * 0.2);
      display: flex;
      gap: 0.18em;
      white-space: nowrap;
    }
  }
  @media (min-width: 1600px) {
    .masthead {
      font-size: calc((1600px - 2 * var(--margin)) * 0.2);
    }
  }

  .under {
    margin-top: clamp(var(--space-6), 3vw + 16px, var(--space-8));
    display: grid;
    gap: var(--space-6);
  }
  .who {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    color: var(--c-ink-2);
    max-width: 34ch;
  }
  .who p:first-child {
    color: var(--c-ink);
    font-weight: 500;
  }
  .pitch {
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.015em;
    max-width: 22ch;
    text-wrap: pretty;
  }
  .actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }
  .avail {
    color: var(--c-ink-2);
  }
  @media (min-width: 1024px) {
    .under {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .who {
      grid-column: 1 / span 3;
      padding-top: 0.45em;
    }
    .what {
      grid-column: 5 / span 8;
    }
  }

  .block {
    margin-top: var(--section);
  }

  .build h2 {
    font-size: var(--step-4);
  }
  .build-body {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-5);
    max-width: 34em;
  }
  .build-body p {
    font-size: var(--step-2);
    line-height: 1.35;
  }
  .how {
    color: var(--c-ink-2);
  }
  .how a {
    color: var(--c-ink);
    text-decoration-thickness: 1px;
  }
  @media (hover: hover) and (pointer: fine) {
    .how a:hover {
      color: var(--c-accent);
      text-decoration-thickness: 2px;
    }
  }
  @media (min-width: 1024px) {
    .build {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: start;
    }
    .build h2 {
      grid-column: 1 / span 4;
    }
    .build-body {
      grid-column: 5 / span 8;
      margin-top: 0;
    }
  }
</style>
