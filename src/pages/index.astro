---
// Home: intro only for now. Task 10 rebuilds Work/Offers/Receipts/Log per
// docs/design-addendum.md §7.2 once their components exist.
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Adriel Tang: Full Stack Developer in Kuala Lumpur"
  description="Full stack developer in Kuala Lumpur. Adriel Tang builds web and mobile apps with Next.js, Flutter, and Laravel. View recent projects and get in touch."
  current="work"
>
  <div class="container">
    <section class="intro">
      <h1>Adriel Tang</h1>
      <p class="role-line">
        Full stack developer in Kuala Lumpur, building web and mobile applications with Next.js, Flutter, and
        Laravel.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    padding-block: 32px 24px;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 500;
  }
  .role-line {
    font-size: var(--step-2);
    max-width: 40ch;
    margin-top: 12px;
  }
  @media (min-width: 1024px) {
    .intro {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
      padding-block: 48px 32px;
    }
    h1 {
      grid-column: 1 / span 6;
    }
    .role-line {
      grid-column: 8 / span 5;
      margin-top: 0;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .intro {
      padding-block: 40px 28px;
    }
    .role-line {
      margin-top: 12px;
    }
  }

  .colophon-lately {
    margin-top: var(--section);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  @media (min-width: 1024px) {
    .colophon-lately {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: start;
      gap: 0;
    }
    .colophon-lately > :global(:first-child) {
      grid-column: 1 / span 4;
    }
    .colophon-lately > :global(:last-child) {
      grid-column: 6 / span 7;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .colophon-lately {
      gap: 64px;
    }
  }
</style>
