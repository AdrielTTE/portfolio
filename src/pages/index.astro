---
// Home: masthead → work → what I build. The hire moment is the saffron
// footer (SiteFooter), so the page itself stays three calm parts.
// Borrowed: the full-width condensed masthead from henry.codes; the quiet
// two-column "who / what" under it from frankchimero.com's index (name on
// the left, content on the right); scale and whitespace instead of rules.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkShowcase from '../components/WorkShowcase.astro';
import MagneticLink from '../components/MagneticLink.astro';
import { site, home, offerCopy } from '../data/site';
import { offersWithProjects } from '../lib/offers';

const allWork = await getCollection('work');
const offers = offersWithProjects(allWork);
// One project leads, large; the rest are the quiet list under it.
// The two things I build get a drawn underline in the pitch.
const emphasis = ['web apps', 'mobile apps'];
const pitchParts = home.pitch
  .split(new RegExp(`(${emphasis.join('|')})`))
  .map((text) => ({ text, em: emphasis.includes(text) }));
---
<BaseLayout title={home.title} description={home.description}>
  <div class="container home">
    <section class="intro" aria-labelledby="intro-h">
      <h1 id="intro-h" class="masthead display">
        <span class="line-mask"><span style="--i:0">Adriel</span></span>
        <span class="line-mask"><span style="--i:1">Tang</span></span>
      </h1>
      <div class="under">
        <div class="who line-rise" style="--i:2">
          <p>{home.roleLine}</p>
          <p class="local" data-clock-wrap hidden>{site.city}, <span data-clock>--:--</span> (UTC+8)</p>
          <dl class="proof">
            {home.proof.map((f) => (<div><dt>{f.label}</dt><dd>{f.note}</dd></div>))}
          </dl>
        </div>
        <div class="what">
          <p class="pitch line-rise" style="--i:3">{pitchParts.map((p, i) => (p.em ? <span class="u" style={`--u:${pitchParts.slice(0, i).filter((q) => q.em).length}`}>{p.text}</span> : p.text))}</p>
          <div class="intro-text line-rise" style="--i:4">
            <p>{home.intro}</p>
          </div>
          <div class="actions line-rise" style="--i:5">
            <MagneticLink href="/contact/">Start a project</MagneticLink>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="container home">
    <div class="block"><WorkShowcase projects={allWork} /></div>
  </div>

  {/* What I build: set like the Work list above it (big condensed title on
      the left, plain description on the right, ruled rows) so the page reads
      as one thing. Each row names the tools and links the projects that show
      them. The only dark field left is the hire block in the footer. */}
  <section class="build" aria-labelledby="build-h">
    <div class="container home">
      <h2 id="build-h" class="display build-h">What I build</h2>
      <ol class="offers">
        {offers.map((o) => (
          <li class="offer">
            <h3 class="offer-title display">{o.label}</h3>
            <div class="offer-body">
              <p class="offer-line">{offerCopy[o.id].line}</p>
              <p class="how">
                {offerCopy[o.id].stack.join(', ')}. See{' '}
                {o.projects.map((p, i) => (
                  <>
                    {i > 0 && (i === o.projects.length - 1 ? ' and ' : ', ')}
                    <a href={`/work/${p.id}/`}>{p.data.title}</a>
                  </>
                ))}.
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
<script src="../scripts/hero-pressure.ts"></script>
</BaseLayout>

<style>
  .intro {
    padding-top: clamp(var(--space-5), 2.5vw + 16px, var(--space-8));
    position: relative;
  }
 things I build draw in left to right, one
     after the other, after the pitch has risen. */
  /* The underline is a background gradient (not a pseudo-element) so it
     follows a phrase that wraps onto two lines. */
  .u {
    background: linear-gradient(var(--c-accent), var(--c-accent)) no-repeat 0 96% / 100% max(0.07em, 3px);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  :global(.js-reveal:not(.intro-seen)) .u {
    animation: u-draw 700ms var(--ease-enter) both;
    animation-delay: calc(500ms + var(--u, 0) * 220ms);
  }
  @keyframes u-draw {
    from {
      background-size: 0% max(0.07em, 3px);
    }
  }
  .intro > * {
    position: relative;
  }


  /* The masthead: two stacked words on phones, one line across the full
     measure from 600px. Sized off the viewport so it always fills, never
     overflows. */
  /* Measured: at 68% width "ADRIEL" sets 2.69em wide and "ADRIEL TANG"
     (with the 0.18em gap) 4.88em, so these factors fill the measure with
     a hair to spare. Recheck them if the face, width or copy changes. */
  .masthead {
    font-size: calc((100vw - 2 * var(--margin)) * 0.36);
    line-height: 0.8;
    letter-spacing: -0.02em;
    color: var(--c-display);
    text-transform: uppercase;
  }
  /* Letter boxes made by scripts/hero-pressure.ts (desktop mouse only). Each
     keeps the width its letter had in the whole word, so a weight change never
     moves its neighbours. */
  .masthead :global(.chs) {
    display: block;
    white-space: nowrap;
  }
  .masthead :global(.ch) {
    display: inline-block;
    text-align: center;
    contain: layout;
  }
  .masthead > .line-mask {
    display: block;
  }
  /* The rise-in mask would clip the tails of the condensed caps' baseline
     overshoot; a little bottom padding keeps them whole. */
  .masthead :global(.line-mask) {
    padding-bottom: 0.04em;
  }
  @media (min-width: 600px) {
    .masthead {
      font-size: calc((100vw - 2 * var(--margin)) * 0.2);
      display: flex;
      gap: 0.18em;
      white-space: nowrap;
    }
  }
  @media (min-width: 1600px) {
    .masthead {
      font-size: calc((1600px - 2 * var(--margin)) * 0.2);
    }
  }

  .under {
    margin-top: clamp(var(--space-6), 3vw + 16px, var(--space-8));
    display: grid;
    gap: var(--space-6);
  }
  .who {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    color: var(--c-ink-2);
    max-width: 34ch;
  }
  .who p:first-child {
    color: var(--c-ink);
    font-weight: 500;
  }
  .proof {
    margin-top: var(--space-3);
    border-top: 1px solid var(--c-rule);
  }
  .proof div {
    display: grid;
    gap: 2px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--c-rule);
  }
  .proof dt {
    color: var(--c-ink);
    font-weight: 600;
  }
  .proof dd {
    font-family: var(--font-data);
    font-size: var(--step--1);
    letter-spacing: -0.01em;
  }
  .pitch {
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.015em;
    max-width: 26ch;
    text-wrap: balance;
  }
  .intro-text {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-3);
    max-width: 44ch;
    color: var(--c-ink-2);
    font-size: var(--step-1);
    line-height: 1.45;
    text-wrap: pretty;
  }
  .actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }
  @media (min-width: 1024px) {
    .under {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .who {
      grid-column: 1 / span 3;
      padding-top: 0.45em;
    }
    .what {
      grid-column: 5 / span 8;
    }
  }

  /* Closer than the other sections so the first project row shows on the
     first screen: the work is the point of the page. */
  .block {
    margin-top: clamp(56px, 4vw + 32px, 104px);
  }

  /* What I build: a three-column spec sheet in running type, on purpose unlike
     the big ruled Work rows above it, so the page does not repeat its best
     moment. Each column opens with a rule and ends in a proof link. */
  .build {
    margin-top: var(--section);
    content-visibility: auto;
    contain-intrinsic-size: auto 640px;
  }
  .build-h {
    font-size: var(--step-4);
    color: var(--c-ink);
    margin-bottom: var(--space-7);
  }
  .offers {
    list-style: none;
    display: grid;
    gap: var(--space-7) var(--gutter);
  }
  .offer {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--c-ink);
  }
  .offer-title {
    font-size: var(--step-3);
    color: var(--c-display);
    line-height: 0.95;
  }
  .offer-body {
    display: grid;
    gap: var(--space-3);
    max-width: 38ch;
  }
  .offer-line {
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .how {
    font-family: var(--font-data);
    font-size: 0.92em;
    letter-spacing: -0.01em;
    color: var(--c-ink-2);
  }
  .how a {
    color: var(--c-ink);
    text-decoration-thickness: 1px;
  }
  @media (hover: hover) and (pointer: fine) {
    .how a:hover {
      color: var(--c-signal);
      text-decoration-thickness: 2px;
    }
  }
  @media (min-width: 900px) {
    .offers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .local {
    font-family: var(--font-data);
    font-size: 0.92em;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
</style>
