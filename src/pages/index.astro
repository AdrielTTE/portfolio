---
// Home: intro (facts strip, statement, actions, system map) → work index →
// receipts → log → working together. Spec §3.1.
// Intro borrows a top facts strip (gilhuybrecht.com) and a big statement with
// a hanging first-line indent (maximiliankaspar.com); the "What I build" map
// is the one interactive element, and it is the offer switcher. Later
// sections sit on the ledger rail (addendum §5.1): heading cols 1-3, content
// cols 4-12 at ≥1024. The work index runs full width for scale contrast.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import OfferSwitcher from '../components/OfferSwitcher.astro';
import WorkList from '../components/WorkList.astro';
import BuildReceipts from '../components/BuildReceipts.astro';
import CommitLog from '../components/CommitLog.astro';
import CopyEmail from '../components/CopyEmail.astro';
import LiveClock from '../components/LiveClock.astro';
import MagneticLink from '../components/MagneticLink.astro';
import { site, home, projectSteps } from '../data/site';

const allWork = await getCollection('work');
const lately = await getCollection('lately');
---
<BaseLayout title={home.title} description={home.description}>
  <div class="container home">
    <section class="intro" aria-labelledby="intro-h" data-magnet-zone>
      <div class="strip">
        <h1 id="intro-h" class="line-mask"><span style="--i:0">{site.name}</span></h1>
        <p class="role line-mask"><span style="--i:1">{home.roleLine}</span></p>
        <p class="fact line-rise" style="--i:1"><LiveClock /> in {site.city}</p>
        <p class="fact avail line-rise" style="--i:2"><span class="on" aria-hidden="true"></span>{site.availability}</p>
      </div>
      <p class="pitch line-mask"><span style="--i:2">{home.pitch}</span></p>
      <div class="actions line-rise" style="--i:3">
        <MagneticLink href="/contact/">Start a project</MagneticLink>
        <CopyEmail email={site.email} label="Copy email" variant="button" />
      </div>
    </section>

    <div class="map line-rise" style="--i:4"><OfferSwitcher projects={allWork} /></div>

    <div class="block block--work" data-reveal><WorkList projects={allWork} /></div>

    <div class="rail rail--receipts" data-reveal><BuildReceipts /></div>

    <div class="rail rail--log" data-reveal>
      <CommitLog entries={lately.map((e) => e.data)} limit={5} heading="Lately">
        <a class="full-log" href="/about/#log">Full log <span class="arrow" aria-hidden="true">→</span></a>
      </CommitLog>
    </div>

    {/* Closing block: one more rail section, not a full-width CTA band. */}
    <div class="rail rail--next" data-reveal>
      <section aria-labelledby="next-h">
        <h2 id="next-h">Working together</h2>
        <p class="next-lede">{site.availability} {site.replyTime}</p>
        <p class="next-how">{projectSteps.join(' ')}</p>
        <div class="next-cta"><MagneticLink href="/contact/">Start a project</MagneticLink></div>
      </section>
    </div>
  </div>
</BaseLayout>

<script src="../scripts/reveal-sections.ts"></script>
<script src="../scripts/stress.ts"></script>

<style>
  .intro {
    padding-top: clamp(var(--space-6), 2.96vw + 37.3px, var(--space-8));
  }

  /* Facts strip: who, what, where, availability. Stacked on phones, four
     equal columns on wide screens. */
  .strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2) var(--gutter);
    font-size: var(--step-0);
    line-height: 1.45;
  }
  h1 {
    grid-column: 1 / -1;
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.45;
  }
  .role {
    grid-column: 1 / -1;
    color: var(--c-ink-2);
    max-width: 44ch;
  }
  .fact {
    color: var(--c-ink-2);
    font-size: var(--step--1);
    margin-top: var(--space-2);
  }
  .avail {
    color: var(--c-ink);
  }
  /* A static status dot: data, not decoration, so it never pulses. */
  .on {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--c-accent);
    vertical-align: 0.05em;
  }
  @media (min-width: 1024px) {
    .strip {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    h1 { grid-column: 1 / span 3; }
    .role { grid-column: 4 / span 4; }
    .fact { grid-column: span 2; margin-top: 0; font-size: var(--step-0); }
    .avail { grid-column: 10 / span 3; }
    .fact:not(.avail) { grid-column: 8 / span 2; }
  }

  /* The statement: set big, first line hung three columns in on wide screens
     so it starts under the role line. */
  .pitch {
    margin-top: clamp(var(--space-7), 2vw + 40px, var(--space-8));
    font-size: clamp(34px, 3.4vw + 21.8px, 70px);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.035em;
    max-width: 22ch;
    text-wrap: balance;
  }
  @media (min-width: 1024px) {
    .pitch {
      max-width: none;
      padding-right: 6%;
      text-indent: calc((100% + var(--gutter)) / 12 * 3);
      text-wrap: pretty;
    }
  }
  .actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  @media (min-width: 1024px) {
    .actions {
      margin-left: calc((100% + var(--gutter)) / 12 * 3);
    }
  }
  /* Below 340px the two buttons stack full width (addendum §7.3). */
  @media (max-width: 339px) {
    .actions > :global(*),
    .actions :global(.copy-button),
    .actions :global(.magnetic) {
      width: 100%;
      justify-content: center;
    }
  }

  /* System map: right under the actions, no rule, so it reads as part of
     the intro. Map cols 1-8 and the offer copy cols 9-12 on wide screens. */
  .map {
    margin-top: clamp(var(--space-7), 1.5vw + 42px, var(--space-8));
  }
  @media (min-width: 1024px) {
    .map :global(.offers) {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: center;
    }
    .map :global(.offers > h2) { grid-column: 1 / -1; }
    .map :global(.sys) { grid-column: 1 / span 8; }
    .map :global(.panels) { grid-column: 9 / span 4; margin-top: 0; }
  }

  .block {
    margin-top: var(--section);
    padding-top: var(--space-4);
  }

  /* Ledger rail (addendum §5.1, §5.3): full-width hairline, --section above,
     space-4 below, then heading + content. */
  .rail {
    margin-top: var(--section);
    border-top: 1px solid var(--c-rule);
    padding-top: var(--space-4);
  }
  .rail > :global(section) > :global(h2) {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.55;
    margin: 0 0 var(--space-4);
  }
  @media (min-width: 1024px) {
    .rail > :global(section) {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: start;
    }
    .rail > :global(section) > :global(*) {
      grid-column: 4 / -1;
    }
    .rail > :global(section) > :global(h2) {
      grid-column: 1 / span 3;
      margin: 0;
    }
  }

  /* Closing block: availability, how a project runs, one CTA. */
  .next-lede {
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.3;
    max-width: 36ch;
  }
  .next-how {
    margin-top: var(--space-3);
    color: var(--c-ink-2);
    max-width: 60ch;
  }
  .next-cta {
    margin-top: var(--space-5);
  }
  @media (min-width: 1024px) {
    .rail--next :global(section) > :global(*) {
      grid-column: 4 / span 7;
    }
  }

  .full-log {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-top: var(--space-3);
    text-decoration: none;
  }
  .full-log .arrow {
    transition: transform var(--dur-fast) var(--ease-enter);
  }
  @media (hover: hover) and (pointer: fine) {
    .full-log:hover {
      color: var(--c-accent);
    }
    .full-log:hover .arrow {
      transform: translateX(3px);
    }
  }
  @media (min-width: 1024px) {
    .rail--log :global(.full-log) {
      justify-self: start;
    }
  }
</style>
