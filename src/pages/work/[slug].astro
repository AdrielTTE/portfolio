---
// docs/design-spec.md §5.2.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeviceFrame from '../../components/DeviceFrame.astro';
import FactsRow from '../../components/FactsRow.astro';
import Prose from '../../components/Prose.astro';
import PrevNext from '../../components/PrevNext.astro';
import CaseSection from '../../components/CaseSection.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import SchemaCard from '../../components/SchemaCard.astro';
import MagneticLink from '../../components/MagneticLink.astro';
import { getPrevNext } from '../../lib/work';

export async function getStaticPaths() {
  const allWork = await getCollection('work');
  return allWork.map((project) => ({
    params: { slug: project.id },
    props: { project, allWork },
  }));
}

const { project, allWork } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, team, scope, stack, year, repo, live } = project.data;
const { prev, next } = getPrevNext(allWork, project.id);

const titles: Record<string, string> = {
  habitect: 'Habitect: A Flutter Habit-Tracking App',
  'package-tracker': 'Package Tracker: A Laravel Web App',
  'this-site': 'This Site: A Static Astro Build',
};
const descriptions: Record<string, string> = {
  habitect:
    'Habitect is a habit-tracking mobile app built with Flutter and Dart by a team of four at TAR UMT. See the stack and the code on GitHub.',
  'package-tracker':
    'Package Tracker is a Laravel, PHP, and MySQL web app for tracking deliveries across customer, admin, and driver logins. See the stack and the code.',
  'this-site':
    'How this portfolio is built: Astro static output, a 25KB JS budget, and real build receipts (page weight, JS shipped, Lighthouse) measured at every deploy.',
};
---
<BaseLayout
  title={titles[project.id] ?? `${title}: Adriel Tang`}
  description={descriptions[project.id] ?? summary}
  current="work"
  currentSlug={project.id}
>
  <div class="container case-study">
    <div class="title-block">
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
    </div>

    <DeviceFrame project={project} variant="hero" eager />

    <FactsRow role={role} team={team} scope={scope} stack={stack} year={year} repo={repo} live={live} />

    <CaseSection id="problem" title="The problem" text={project.data.problem} />
    <CaseSection id="built" title="How it's built" show={Boolean(project.data.diagram)}>
      {project.data.diagram && <ArchDiagram diagram={project.data.diagram} />}
    </CaseSection>
    <CaseSection id="data" title="Data model" show={Boolean(project.data.schema)}>
      {project.data.schema && <SchemaCard schema={project.data.schema} />}
    </CaseSection>
    <CaseSection id="decision" title="A decision worth explaining" text={project.data.decision} />
    <CaseSection id="change" title="What I'd change" text={project.data.change} />
    <Prose><Content /></Prose>
    <CaseSection id="for-you" title="What this means for your project" text={project.data.forYou}>
      <p class="cta"><MagneticLink href="/contact/">Start a project</MagneticLink></p>
    </CaseSection>
    <PrevNext prev={prev} next={next} />
  </div>
</BaseLayout>

<style>
  .case-study {
    padding-block: 24px;
  }
  .title-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }
  h1 {
    font-size: var(--step-5);
    font-weight: 600;
  }
  /* The one in-page CTA closes "What this means for your project"
     (addendum §7.4), space-5 above. */
  .cta {
    margin-top: var(--space-5);
  }
  .summary {
    font-size: var(--step-3);
    font-weight: 500;
    max-width: 34ch;
  }
  @media (min-width: 768px) {
    .case-study {
      padding-block: 32px;
    }
  }
  @media (min-width: 1024px) {
    .case-study {
      padding-block: 48px;
    }
    .title-block {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: last baseline;
      margin-bottom: 32px;
    }
    h1 {
      grid-column: 1 / span 7;
    }
    .summary {
      grid-column: 8 / span 5;
    }
  }
</style>
