---
// docs/design-spec.md §5.2.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeviceFrame from '../../components/DeviceFrame.astro';
import FactsRow from '../../components/FactsRow.astro';
import Prose from '../../components/Prose.astro';
import PrevNext from '../../components/PrevNext.astro';
import CaseSection from '../../components/CaseSection.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import SchemaCard from '../../components/SchemaCard.astro';
import { getPrevNext } from '../../lib/work';

export async function getStaticPaths() {
  const allWork = await getCollection('work');
  return allWork.map((project) => ({
    params: { slug: project.id },
    props: { project, allWork },
  }));
}

const { project, allWork } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, team, scope, stack, year, repo, live, seoTitle, seoDescription } = project.data;
const { prev, next } = getPrevNext(allWork, project.id);
---
<BaseLayout
  title={seoTitle ?? `${title}: Adriel Tang`}
  description={seoDescription ?? summary}
  ogType="article"
  current="work"
  currentSlug={project.id}
>
  <div class="container case-study">
    {/* The way out sits first, above the title, so it's in view without
        scrolling on a 360px phone. */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/#work" class="crumb-back"><span class="arrow" aria-hidden="true">←</span> All work</a></li>
        <li aria-current="page"><span class="sep" aria-hidden="true">/</span> {title}</li>
      </ol>
    </nav>
    <div class="title-block">
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
    </div>

    <DeviceFrame project={project} variant="hero" eager />

    <FactsRow role={role} team={team} scope={scope} stack={stack} year={year} repo={repo} live={live} />

    {/* The Markdown body (what it is, who it's for) comes first, so a reader
        knows what the project is before the decisions. */}
    <CaseSection id="overview" title="Overview" show={Boolean(project.body?.trim())}>
      <Prose><Content /></Prose>
    </CaseSection>
    <CaseSection id="problem" title="The problem" text={project.data.problem} />
    <CaseSection id="built" title="How it's built" show={Boolean(project.data.diagram)}>
      {project.data.diagram && <ArchDiagram diagram={project.data.diagram} />}
    </CaseSection>
    <CaseSection id="data" title="Data model" show={Boolean(project.data.schema)}>
      {project.data.schema && <SchemaCard schema={project.data.schema} />}
    </CaseSection>
    <CaseSection id="decision" title="A decision worth explaining" text={project.data.decision} />
    <CaseSection id="change" title="What I'd change" text={project.data.change} />
    {/* The contact CTA now closes the page inside PrevNext's end block. */}
    <CaseSection id="for-you" title="What this means for your project" text={project.data.forYou} />
    <PrevNext prev={prev} next={next} />
  </div>
</BaseLayout>

<style>
  .case-study {
    padding-block: 24px;
  }
  .title-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }
  h1 {
    font-size: var(--step-5);
    font-weight: 600;
  }
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 10px;
    margin-bottom: var(--space-4);
  }
  .crumbs li[aria-current] {
    color: var(--c-ink-2);
  }
  .sep {
    margin-right: 6px;
  }
  /* A 44px target that reads as a control, not body text. */
  .crumb-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding-inline: 12px 14px;
    border: 1px solid var(--c-rule);
    border-radius: 4px;
    font-weight: 500;
    text-decoration: none;
  }
  .crumb-back .arrow {
    transition: transform var(--dur-fast) var(--ease-enter);
  }
  @media (hover: hover) and (pointer: fine) {
    .crumb-back:hover {
      border-color: var(--c-ink);
    }
    .crumb-back:hover .arrow {
      transform: translateX(-3px);
    }
  }
  .summary {
    font-size: var(--step-3);
    font-weight: 500;
    max-width: 34ch;
  }
  @media (min-width: 768px) {
    .case-study {
      padding-block: 32px;
    }
  }
  @media (min-width: 1024px) {
    .case-study {
      padding-block: 48px;
    }
    .title-block {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: last baseline;
      margin-bottom: 32px;
    }
    h1 {
      grid-column: 1 / span 7;
    }
    .summary {
      grid-column: 8 / span 5;
    }
  }
</style>
