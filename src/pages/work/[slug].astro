---
// Case study: way out → title → facts → real screenshots (only if they
// exist) → the write-up in one reading column → prev/next and contact.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Shots from '../../components/Shots.astro';
import ProjectMark from '../../components/ProjectMark.astro';
import FactsRow from '../../components/FactsRow.astro';
import Prose from '../../components/Prose.astro';
import PrevNext from '../../components/PrevNext.astro';
import CaseSection from '../../components/CaseSection.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import BuildReceipts from '../../components/BuildReceipts.astro';
import { getPrevNext } from '../../lib/work';

export async function getStaticPaths() {
  const allWork = await getCollection('work');
  return allWork.map((project) => ({
    params: { slug: project.id },
    props: { project, allWork },
  }));
}

const { project, allWork } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, team, scope, stack, year, repo, live, seoTitle, seoDescription } = project.data;
const { prev, next } = getPrevNext(allWork, project.id);
---
<BaseLayout
  title={seoTitle ?? `${title}: Adriel Tang`}
  description={seoDescription ?? summary}
  ogType="article"
  current="work"
>
  <div class="container case-study">
    {/* The way out sits first, above the title, so it's in view without
        scrolling on a 360px phone. */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/#work" class="crumb-back"><span class="arrow" aria-hidden="true">←</span> All work</a></li>
        <li aria-current="page" class="visually-hidden">{title}</li>
      </ol>
    </nav>
    <header class="title-block">
      <h1 class="display">{title}</h1>
      <p class="summary">{summary}</p>
      {project.data.mark && <div class="mark-slot"><ProjectMark kind={project.data.mark} /></div>}
    </header>

    <FactsRow role={role} team={team} scope={scope} stack={stack} year={year} repo={repo} live={live} />

    <div class="shots-wrap"><Shots project={project} /></div>

    {/* The Markdown body (what it is, who it's for) comes first, so a reader
        knows what the project is before the decisions. */}
    <CaseSection id="overview" title="Overview" show={Boolean(project.body?.trim())}>
      <Prose><Content /></Prose>
    </CaseSection>
    <CaseSection id="numbers" title="The numbers" show={project.data.receipts}>
      <BuildReceipts />
    </CaseSection>
    <CaseSection id="problem" title="The problem" text={project.data.problem} />
    <CaseSection id="built" title="How it's built" show={Boolean(project.data.diagram)}>
      {project.data.diagram && <ArchDiagram diagram={project.data.diagram} />}
    </CaseSection>
    <CaseSection id="change" title="What I'd change" text={project.data.change} />
    <CaseSection id="for-you" title="What this means for your project" text={project.data.forYou} />
    <PrevNext prev={prev} next={next} />
  </div>
</BaseLayout>

<style>
  .case-study {
    padding-top: var(--space-4);
  }
  .crumbs ol {
    list-style: none;
  }
  .crumb-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 500;
    text-decoration: none;
  }
  .crumb-back .arrow {
    transition: transform var(--dur-fast) var(--ease-enter);
  }
  @media (hover: hover) and (pointer: fine) {
    .crumb-back:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
    .crumb-back:hover .arrow {
      transform: translateX(-3px);
    }
  }
  .title-block {
    margin-top: clamp(var(--space-6), 4vw, var(--space-9));
    display: grid;
    gap: var(--space-5);
  }
  .mark-slot {
    --mark: 56px;
    order: -1;
  }
  h1 {
    font-size: clamp(64px, 11vw, 176px);
    line-height: 0.82;
    color: var(--c-display);
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .summary {
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 28ch;
  }
  .shots-wrap:has(:global(.shots)) {
    margin-top: var(--space-7);
  }
  @media (min-width: 1024px) {
    .title-block {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
    }
    .mark-slot {
      --mark: 72px;
      grid-column: 1 / -1;
    }
    h1 {
      grid-column: 1 / span 8;
    }
    .summary {
      grid-column: 9 / span 4;
    }
  }
</style>
