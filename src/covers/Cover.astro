---
// Resolves and sizes a project's cover per docs/design-spec.md §7.1 and §8.
// Resolution order: registered composition -> frontmatter `cover` image ->
// DefaultCover. Every variant gives the plate a definite size (never
// `min-height` alone), so `cqh` inside compositions never resolves to 0.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { plateFor, onPlate } from '../lib/plate';
import { coverRegistry } from './registry';
import DefaultCover from './DefaultCover.astro';

type Variant = 'lead' | 'feature' | 'archive' | 'hero' | 'thumb' | 'preview';

interface Props {
  project: CollectionEntry<'work'>;
  variant: Variant;
  slotIndex?: 1 | 2 | 3 | 4;
  eager?: boolean;
  reveal?: boolean;
}

const { project, variant, slotIndex, eager = false, reveal } = Astro.props;

const compact = variant === 'archive' || variant === 'thumb' || variant === 'preview';
const shouldReveal = reveal ?? (variant === 'lead' || variant === 'feature' || variant === 'hero');
const emitSlug = variant === 'lead' || variant === 'feature' || variant === 'archive';

const plate = plateFor(project);
const onPlateColor = onPlate(plate);
const RegisteredCover = coverRegistry[project.id];
const coverAlt = project.data.coverAlt ?? `${project.data.title} (${project.data.scope}, ${project.data.year})`;

const style = `--plate:${plate};--c-on-plate:${onPlateColor}${
  variant === 'hero' ? ';view-transition-name:cover' : ''
}`;
---

<div
  class="plate"
  class:list={[`plate--${variant}`, { in: !shouldReveal }]}
  style={style}
  data-variant={variant}
  data-slot={slotIndex}
  data-cover-slug={emitSlug ? project.id : undefined}
  data-reveal={shouldReveal ? 'true' : undefined}
  role="img"
  aria-label={coverAlt}
>
  {
    RegisteredCover ? (
      <RegisteredCover project={project} compact={compact} />
    ) : project.data.cover ? (
      <Image
        src={project.data.cover}
        alt=""
        widths={[400, 800, 1200]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        class="cover-image"
      />
    ) : (
      <DefaultCover project={project} compact={compact} />
    )
  }
</div>

<style>
  .plate {
    position: relative;
    container-type: size;
    overflow: clip;
    background: var(--plate);
    color: var(--c-on-plate);
  }
  .cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Lead ------------------------------------------------------------------ */
  .plate--lead {
    aspect-ratio: 1 / 1;
  }
  @media (min-width: 768px) {
    .plate--lead {
      aspect-ratio: 4 / 3;
    }
  }
  @media (min-width: 1024px) {
    .plate--lead {
      aspect-ratio: auto;
      height: min(680px, calc(100svh - 240px));
      min-height: 420px;
    }
  }

  /* Hero (case study) ------------------------------------------------------*/
  .plate--hero {
    aspect-ratio: 1 / 1;
  }
  @media (min-width: 768px) {
    .plate--hero {
      aspect-ratio: 4 / 3;
    }
  }
  @media (min-width: 1024px) {
    .plate--hero {
      aspect-ratio: auto;
      height: min(760px, calc(100svh - 160px));
      min-height: 440px;
    }
  }

  /* Feature (4-slot rhythm) --------------------------------------------------*/
  .plate--feature {
    aspect-ratio: var(--tile-aspect-360, 1 / 1);
  }
  @media (min-width: 768px) {
    .plate--feature[data-slot='1'] { aspect-ratio: 4 / 3; }
    .plate--feature[data-slot='2'] { aspect-ratio: 4 / 5; }
    .plate--feature[data-slot='3'] { aspect-ratio: 3 / 2; }
    .plate--feature[data-slot='4'] { aspect-ratio: 1 / 1; }
  }
  @media (min-width: 1024px) {
    .plate--feature[data-slot='1'] { aspect-ratio: 4 / 3; }
    .plate--feature[data-slot='2'] { aspect-ratio: 4 / 5; }
    .plate--feature[data-slot='3'] { aspect-ratio: 1 / 1; }
    .plate--feature[data-slot='4'] { aspect-ratio: 3 / 2; }
  }

  /* Archive ------------------------------------------------------------------*/
  .plate--archive {
    aspect-ratio: 4 / 3;
  }

  /* Thumb (Index, touch) and preview (Index, desktop hover) ------------------*/
  .plate--thumb {
    width: 56px;
    height: 42px;
  }
  .plate--preview {
    width: 280px;
    height: 210px;
  }
</style>
