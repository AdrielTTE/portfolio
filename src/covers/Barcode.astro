---
// Decorative, deterministic barcode: not a real symbology, just bars whose
// widths are derived from the tracking string so the same value always
// renders the same pattern. Used on the Package Tracker waybill.
interface Props {
  value: string;
  height?: number;
}
const { value, height = 40 } = Astro.props;

function seedFrom(input: string): number[] {
  const codes = [...input].map((c) => c.charCodeAt(0));
  const bars: number[] = [];
  for (let i = 0; i < 46; i++) {
    const code = codes[i % codes.length] + i * 7;
    bars.push(1 + (code % 3));
  }
  return bars;
}

const bars = seedFrom(value);
const gap = 1;
let x = 0;
const rects = bars.map((w) => {
  const rect = { x, w };
  x += w + gap;
  return rect;
});
const totalWidth = x;
---
<svg
  viewBox={`0 0 ${totalWidth} ${height}`}
  width="100%"
  height={height}
  preserveAspectRatio="none"
  role="presentation"
  aria-hidden="true"
>
  {rects.map((r) => <rect x={r.x} y="0" width={r.w} height={height} fill="currentColor" />)}
</svg>
