---
// Fallback cover for a project with no registered composition and no
// screenshot: a typographic label on the plate, not a fake UI. Holds up at
// 40+ repeats without looking like a placeholder. docs/design-spec.md §7.5.
import type { CollectionEntry } from 'astro:content';
import CompactLabel from './CompactLabel.astro';

interface Props {
  project: CollectionEntry<'work'>;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const { scope, year, stack, title } = project.data;
---
{
  compact ? (
    <CompactLabel title={title} />
  ) : (
    <div class="default-cover" aria-hidden="true">
      <p class="meta meta-top">{scope} · {year}</p>
      <p class="obj title" data-small aria-hidden="true">{title}</p>
      <p class="meta meta-bottom">{stack.join(' / ')}</p>
    </div>
  )
}

<style>
  .default-cover {
    position: absolute;
    inset: 0;
    color: var(--c-on-plate);
  }
  .meta {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 3cqh;
    margin: 0;
  }
  .meta-top {
    top: 6cqh;
    left: 6cqh;
  }
  .meta-bottom {
    bottom: 6cqh;
    right: 6cqh;
    text-align: right;
    max-width: 40cqh;
  }
  .title {
    position: absolute;
    left: 6cqh;
    right: 6cqh;
    bottom: 6cqh;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 11cqh;
    line-height: 0.95;
    letter-spacing: -0.03em;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
</style>
