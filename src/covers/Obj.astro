---
// One printed object inside a `.plate` composition. Positioned from the
// centre in `cqh` units so the whole composition holds at any tile size.
// See docs/design-spec.md §7.2.
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  r?: number;
  class?: string;
  style?: string;
}
const { x, y, w, h, r = 0, class: className, style: extraStyle } = Astro.props;
const style = `--x:${x};--y:${y};--w:${w};--h:${h};--r:${r}deg${extraStyle ? `;${extraStyle}` : ''}`;
---
<span class={`obj ${className ?? ''}`} style={style}>
  <slot />
</span>

<style>
  .obj {
    position: absolute;
    left: calc(50% + (var(--x, 0) - var(--w, 20) / 2) * 1cqh);
    top: calc(50% + (var(--y, 0) - var(--h, 20) / 2) * 1cqh);
    width: calc(var(--w, 20) * 1cqh);
    height: calc(var(--h, 20) * 1cqh);
    rotate: var(--r, 0deg);
    filter: drop-shadow(0 0.6cqh 0.8cqh rgb(0 0 0 / 0.18));
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .obj {
      transition: translate var(--dur-base) var(--ease-enter), rotate var(--dur-base) var(--ease-enter);
    }
  }
</style>
