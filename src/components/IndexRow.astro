---
// docs/design-spec.md §5.1.3.
import type { CollectionEntry } from 'astro:content';
import Cover from '../covers/Cover.astro';

interface Props {
  project: CollectionEntry<'work'>;
  no: number;
}
const { project, no } = Astro.props;
const { title, scope, stack, year } = project.data;
---
<li>
  <a href={`/work/${project.id}`} class="index-row" data-scope={scope} data-year={year} data-slug={project.id}>
    <span class="no">No. {no}</span>
    <span class="thumb"><Cover project={project} variant="thumb" /></span>
    <span class="name">
      {title}
      <span class="name-scope">{scope}</span>
    </span>
    <span class="scope">{scope}</span>
    <span class="stack">{stack.join(', ')}</span>
    <span class="year">{year}</span>
  </a>
</li>

<style>
  .index-row {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    border-top: 1px solid var(--c-rule);
    text-decoration: none;
    color: inherit;
    padding-block: 8px;
  }
  .no {
    display: none;
    white-space: nowrap;
  }
  .thumb {
    display: block;
  }
  .name {
    font-weight: 500;
    font-size: var(--step-0);
    display: flex;
    flex-direction: column;
  }
  .name-scope {
    font-weight: 400;
    color: var(--c-ink-2);
    font-size: var(--step-0);
  }
  .scope,
  .stack {
    display: none;
  }
  .year {
    font-family: var(--font-mono);
    text-align: right;
  }

  @media (min-width: 768px) {
    .index-row {
      grid-template-columns: 6ch 3fr 3fr auto;
    }
    .no {
      display: block;
      font-family: var(--font-mono);
      color: var(--c-ink-2);
    }
    .thumb {
      display: none;
    }
    .name {
      flex-direction: row;
    }
    .name-scope {
      display: none;
    }
    .scope {
      display: block;
      color: var(--c-ink-2);
    }
  }

  @media (min-width: 1024px) {
    .index-row {
      grid-template-columns: 6ch 4fr 3fr 3fr auto;
    }
    .stack {
      display: block;
      color: var(--c-ink-2);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .index-row:hover {
      background: var(--c-paper-2);
    }
  }
  .index-row:focus-visible {
    outline-offset: -2px;
  }
</style>
