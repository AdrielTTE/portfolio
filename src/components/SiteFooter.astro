---
// docs/design-spec.md §5.6. "Source" link is left out until the owner decides
// whether to make the site repo public - see docs/open-items.md.
import type { CollectionEntry } from 'astro:content';
import FooterStrip from './FooterStrip.astro';
import { site } from '../data/site';

interface Props {
  projects: CollectionEntry<'work'>[];
  currentSlug?: string;
}
const { projects, currentSlug } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer" id="site-footer">
  <div class="container">
    <FooterStrip projects={projects} currentSlug={currentSlug} />
    <ul class="links-row">
      <li><a href="/#work">Work</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
      <li><a class="breakable" href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.github} rel="noopener" target="_blank">GitHub <span class="arrow">↗</span></a></li>
      <li><a href={site.linkedin} rel="noopener" target="_blank">LinkedIn <span class="arrow">↗</span></a></li>
      <li><a href="/sitemap-index.xml">Sitemap</a></li>
    </ul>
    <p class="palette-hint">Press <kbd data-kbd-mod>⌘K</kbd> to jump anywhere</p>
    <p class="colophon-line">
      Built with Astro. Set in Hanken Grotesk and JetBrains Mono.
      <span class="copyright">© {year} Adriel Tang</span>
      <span class="sha" data-receipt-wrap="sha" hidden>Built from <a data-receipt="sha" data-href-template="https://github.com/AdrielTTE/portfolio/commit/{v}" hidden></a></span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section);
    padding-bottom: 48px;
    border-top: 1px solid var(--c-ink);
    padding-top: 32px;
  }
  .links-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 48px;
    font-size: var(--step-0);
  }
  .links-row a {
    text-decoration: none;
  }
  .links-row a:hover {
    text-decoration: underline;
  }
  .palette-hint {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
  @media (pointer: coarse) {
    .palette-hint {
      display: none;
    }
  }
  .colophon-line {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px;
  }
  .sha {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
</style>
