---
// Site footer, and the one colour block on the site: a solid espresso back
// cover (the flat colour field). On every page but
// /contact it opens with the hire moment, so no page needs its own CTA band.
// Borrowed: the solid colour field from felixpeault.com's colour-blocked
// sections; the "back cover" idea from print. "Source" link is left out until
// the owner decides whether to make the site repo public (docs/open-items.md).
import MagneticLink from './MagneticLink.astro';
import CopyEmail from './CopyEmail.astro';
import { site } from '../data/site';

interface Props {
  hire?: boolean;
}
const { hire = true } = Astro.props;
const year = new Date().getFullYear();
---
<footer class:list={['site-footer', { slim: !hire }]} id="site-footer">
  {hire && (<><span class="shape disc" aria-hidden="true"></span><span class="shape steps" aria-hidden="true"><i></i><i></i><i></i></span></>)}
  <div class="container">
    {hire && (
      <section class="hire" aria-labelledby="hire-h">
        <h2 id="hire-h" class="display">{site.availability}</h2>
        <div class="hire-body">
          <p class="lede">Tell me what you need built: a web app, an API and its database, or a mobile app. {site.replyTime}</p>
          <p class="mail">
            <a class="breakable" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <div class="actions">
            <MagneticLink href="/contact/">Start a project</MagneticLink>
            <CopyEmail email={site.email} label="Copy email" variant="button" />
          </div>
        </div>
      </section>
    )}
    <div class="base">
      <ul class="links-row">
        <li><a href="/#work">Work</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href={site.github} rel="noopener" target="_blank">GitHub <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a></li>
        <li><a href={site.linkedin} rel="noopener" target="_blank">LinkedIn <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
      <p class="colophon-line">
        <span>© {year} Adriel Tang, {site.city}.</span>
        <span>Built with Astro, set in Archivo.</span>
        <span class="local" data-clock-wrap hidden>Local time <span data-clock>--:--</span> in {site.city}.</span>
        <span class="palette-hint">Press <kbd data-kbd-mod>⌘K</kbd> to jump anywhere.</span>
        <span class="sha" data-receipt-wrap="sha" hidden>Built from <a data-receipt="sha" data-href-template="https://github.com/AdrielTTE/portfolio/commit/{v}" hidden></a></span>
      </p>
    </div>
  </div>
</footer>

<script src="../scripts/clock.ts"></script>

<style>
  .site-footer {
    position: relative;
    overflow: clip;
    margin-top: var(--section);
    background: var(--c-block);
    color: var(--c-block-ink);
    padding-block: var(--space-9) var(--space-6);
    /* Everything inside reads on the espresso field in both themes. */
    --c-ink: var(--c-block-ink);
    --c-ink-2: var(--c-block-ink-2);
    --c-focus: var(--c-block-ink);
    --c-bg-2: color-mix(in oklab, var(--c-block) 82%, var(--c-block-ink));
  }
  .hire {
    padding-bottom: var(--space-9);
  }
  .container {
    position: relative;
  }
  /* Flat shapes in a lighter brown, behind the text. Wide screens only. */
  .shape {
    display: none;
  }
  @media (min-width: 900px) {
    .shape {
      display: block;
      position: absolute;
      pointer-events: none;
    }
    .disc {
      right: -10%;
      bottom: -42%;
      width: min(46vw, 640px);
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--c-shape-field);
    }
    .steps {
      top: 0;
      right: var(--margin);
      display: flex;
      align-items: flex-start;
      gap: 6px;
    }
    .steps i {
      display: block;
      width: 20px;
      background: var(--c-shape-field);
    }
    .steps i:nth-child(1) {
      height: 28px;
    }
    .steps i:nth-child(2) {
      height: 52px;
    }
    .steps i:nth-child(3) {
      height: 80px;
    }
  }
  /* No hire block (on /contact): just the base line on the espresso field. */
  .slim {
    padding-top: var(--space-5);
  }
  .slim .base {
    border-top: 0;
    padding-top: 0;
  }
  h2 {
    font-size: var(--step-6);
    max-width: 12ch;
  }
  /* Scroll-driven (where supported): the headline rises into place. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      h2 {
        animation: foot-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 90%;
      }
    }
  }
  @keyframes foot-in {
    from {
      opacity: 0;
      transform: translateY(48px);
    }
  }
  .hire-body {
    margin-top: var(--space-6);
    max-width: 44ch;
  }
  .lede {
    font-size: var(--step-2);
    line-height: 1.35;
  }
  .mail {
    margin-top: var(--space-5);
    font-size: var(--step-3);
    font-weight: 600;
  }
  .mail a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  /* On the saffron block the primary button inverts to the paper colour. */
  .actions :global(.magnetic) {
    background: var(--c-block-ink);
    color: var(--c-block);
  }
  @media (hover: hover) and (pointer: fine) {
    .actions :global(.magnetic:hover) {
      background: color-mix(in oklab, var(--c-block-ink) 80%, var(--c-block));
    }
  }
  .actions :global(.copy-button) {
    border-color: var(--c-block-ink);
  }
  @media (min-width: 1024px) {
    .hire {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
    }
    h2 {
      grid-column: 1 / span 7;
    }
    .hire-body {
      grid-column: 8 / span 5;
      margin-top: 0;
    }
  }
  @media (max-width: 339px) {
    .actions > :global(*),
    .actions :global(.copy-button),
    .actions :global(.magnetic) {
      width: 100%;
      justify-content: center;
    }
  }

  .base {
    border-top: 1px solid var(--c-block-ink);
    padding-top: var(--space-4);
  }
  .links-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }
  .links-row a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    text-decoration: none;
  }
  .links-row a:hover {
    text-decoration: underline;
  }
  .colophon-line {
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-size: var(--step--1);
    color: var(--c-block-ink-2);
  }
  kbd {
    font-family: inherit;
  }
  @media (pointer: coarse) {
    .palette-hint {
      display: none;
    }
  }
</style>
