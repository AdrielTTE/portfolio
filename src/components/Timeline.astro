---
// docs/design-spec.md §5.3.
interface Item {
  start: string;
  end: string;
  role: string;
  org: string;
  note?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<ol class="timeline">
  {
    items.map((item) => (
      <li>
        <span class="date">
          {item.start} – {item.end}
        </span>
        <span class="body">
          <span class="role">{item.role}</span>
          <span class="org">{item.org}</span>
          {item.note && <span class="note">{item.note}</span>}
        </span>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    display: grid;
    gap: var(--space-5);
  }
  .timeline li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 16px;
  }
  .date {
    color: var(--c-ink-2);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .role {
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .org {
    color: var(--c-ink-2);
  }
  .note {
    font-size: var(--step-0);
  }
  @media (max-width: 599px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
