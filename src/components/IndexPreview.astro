---
// docs/design-spec.md §5.1.3. Desktop-only hover preview that trails the
// pointer; touch/below-768 gets a static thumb per row instead (IndexRow).
import type { CollectionEntry } from 'astro:content';
import Cover from '../covers/Cover.astro';

interface Props {
  projects: CollectionEntry<'work'>[];
}
const { projects } = Astro.props;
---
<div class="index-preview" id="index-preview" aria-hidden="true">
  <div class="preview-inner" id="index-preview-inner"></div>
</div>
{
  projects.map((project) => (
    <template data-preview-slug={project.id}>
      <Cover project={project} variant="preview" />
    </template>
  ))
}

<style>
  .index-preview {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    pointer-events: none;
    opacity: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .index-preview {
      display: block;
    }
  }
  .index-preview.visible {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .index-preview {
      transition: opacity 120ms var(--ease-enter);
    }
    .preview-inner {
      transition: translate 180ms var(--ease-enter);
    }
  }
  template {
    display: none;
  }
</style>
