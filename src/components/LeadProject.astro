---
// docs/design-spec.md §5.1.2. The lead is the first featured entry by order.
import type { CollectionEntry } from 'astro:content';
import Cover from '../covers/Cover.astro';

interface Props {
  project: CollectionEntry<'work'>;
  no: number;
}
const { project, no } = Astro.props;
const { title, scope, team, year } = project.data;
const scopeLine = team ? `${scope}, ${team.toLowerCase()}` : scope;
---
<a href={`/work/${project.id}`} class="lead">
  <Cover project={project} variant="lead" eager />
  <span class="caption">
    <span class="caption-top">
      <span class="no">No. {no}</span>
      <span class="title">{title}</span>
      <span class="view">View project <span class="arrow">→</span></span>
    </span>
    <span class="meta">{scopeLine} · {year}</span>
  </span>
</a>

<style>
  .lead {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .caption {
    display: block;
    margin-top: 12px;
  }
  .caption-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .no {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
  .title {
    font-weight: 500;
    font-size: var(--step-0);
  }
  .view {
    margin-left: auto;
    font-weight: 500;
    font-size: var(--step-0);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .lead:hover .view .arrow {
      translate: 4px 0;
      transition: translate var(--dur-fast) var(--ease-enter);
    }
  }
  .meta {
    display: block;
    color: var(--c-ink-2);
    font-size: var(--step-0);
    margin-top: 4px;
  }
</style>
