---
import Icon from './Icon.astro';
// End of a case study: never a dead end. Back to all work, the previous and
// next project (chronological `order`, no wrap-around; a missing side is
// omitted), and the contact line. The espresso footer follows straight after
// with the full hire block, so the contact here is one plain line.
interface Props {
  prev?: { title: string; slug: string; stage?: string; accent?: string };
  next?: { title: string; slug: string; stage?: string; accent?: string };
}
const { prev, next } = Astro.props;
---
<nav class="end" aria-label="More work">
  {(prev || next) && (
    <ul class="adjacent">
      {prev && (
        <li class="prev">
          <a href={`/work/${prev.slug}/`}>
            <span class="dir">Previous</span>
            <span class="t display"><span class="arrow" aria-hidden="true"><Icon name="arrow-left" /></span> {prev.title}</span>
          </a>
        </li>
      )}
      {next && (
        <li class="next">
          <a href={`/work/${next.slug}/`} class:list={{ tinted: Boolean(next.stage) }} style={next.stage ? `--stage:${next.stage};--accent:${next.accent ?? '#f3f4f2'}` : undefined}>
            <span class="dir">Next</span>
            <span class="t display">{next.title} <span class="arrow" aria-hidden="true"><Icon name="arrow-right" /></span></span>
          </a>
        </li>
      )}
    </ul>
  )}
  <p class="more">
    <a href="/#work" class="back"><span class="arrow" aria-hidden="true"><Icon name="arrow-left" /></span> All work</a>
    <a href="/contact/" class="talk">Need something like this built? Start a project <span class="arrow" aria-hidden="true"><Icon name="arrow-right" /></span></a>
  </p>
</nav>

<style>
  .end {
    margin-top: clamp(var(--space-8), 5vw + 24px, var(--space-10));
    border-top: 1px solid var(--c-ink);
  }
  .adjacent {
    list-style: none;
    display: grid;
  }
  .adjacent li + li {
    border-top: 1px solid var(--c-rule);
  }
  .adjacent a {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6);
    text-decoration: none;
  }
  .dir {
    color: var(--c-ink-2);
  }
  .t {
    font-size: var(--step-5);
    color: var(--c-display);
    text-transform: uppercase;
  }
  /* The next project arrives in its own colour: a taste of what is behind the link. */
  .adjacent a.tinted {
    margin-block: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-2);
    background: var(--stage);
    color: #f3f4f2;
    --c-focus: #f3f4f2;
  }
  .tinted .dir {
    color: var(--accent);
  }
  .tinted .t {
    color: #f3f4f2;
  }
  .t .arrow {
    font-stretch: 100%;
    font-weight: 400;
    font-size: 0.6em;
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    border-top: 1px solid var(--c-rule);
    padding-top: var(--space-3);
  }
  .back,
  .talk {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 500;
    font-size: var(--step-1);
  }
  .back {
    text-decoration: none;
  }
  .arrow {
    transition: transform var(--dur-base) var(--spring);
  }
  /* Touch press feedback: hover is fine-pointer only. */
  .adjacent a:active,
  .back:active,
  .talk:active {
    opacity: 0.6;
  }
  @media (hover: hover) and (pointer: fine) {
    .back:hover {
      text-decoration: underline;
    }
  }
  @media (min-width: 768px) {
    .adjacent {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--gutter);
    }
    .adjacent li + li {
      border-top: 0;
    }
    .next {
      grid-column: 2;
      text-align: right;
    }
  }
</style>
