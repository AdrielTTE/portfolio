---
// End of a case study: never a dead end. Back to all work, the previous and
// next project (chronological `order`, no wrap-around; a missing side is
// omitted), and the contact line. The espresso footer follows straight after
// with the full hire block, so the contact here is one plain line.
interface Props {
  prev?: { title: string; slug: string };
  next?: { title: string; slug: string };
}
const { prev, next } = Astro.props;
---
<nav class="end" aria-label="More work">
  {(prev || next) && (
    <ul class="adjacent">
      {prev && (
        <li class="prev">
          <a href={`/work/${prev.slug}/`}>
            <span class="dir">Previous</span>
            <span class="t display"><span class="arrow" aria-hidden="true">←</span> {prev.title}</span>
          </a>
        </li>
      )}
      {next && (
        <li class="next">
          <a href={`/work/${next.slug}/`}>
            <span class="dir">Next</span>
            <span class="t display">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      )}
    </ul>
  )}
  <p class="more">
    <a href="/#work" class="back"><span class="arrow" aria-hidden="true">←</span> All work</a>
    <a href="/contact/" class="talk">Need something like this built? Start a project <span class="arrow" aria-hidden="true">→</span></a>
  </p>
</nav>

<style>
  .end {
    margin-top: clamp(var(--space-8), 5vw + 24px, var(--space-10));
    border-top: 1px solid var(--c-ink);
  }
  .adjacent {
    list-style: none;
    display: grid;
  }
  .adjacent li + li {
    border-top: 1px solid var(--c-rule);
  }
  .adjacent a {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6);
    text-decoration: none;
  }
  .dir {
    color: var(--c-ink-2);
  }
  .t {
    font-size: var(--step-5);
    color: var(--c-display);
    text-transform: uppercase;
  }
  .t .arrow {
    font-stretch: 100%;
    font-weight: 400;
    font-size: 0.6em;
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    border-top: 1px solid var(--c-rule);
    padding-top: var(--space-3);
  }
  .back,
  .talk {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 500;
    font-size: var(--step-1);
  }
  .back {
    text-decoration: none;
  }
  .arrow {
    transition: transform var(--dur-fast) var(--ease-enter);
  }
  @media (hover: hover) and (pointer: fine) {
    .back:hover {
      text-decoration: underline;
    }
    .back:hover .arrow,
    .prev a:hover .arrow {
      transform: translateX(-4px);
    }
    .next a:hover .arrow,
    .talk:hover .arrow {
      transform: translateX(4px);
    }
  }
  @media (min-width: 768px) {
    .adjacent {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--gutter);
    }
    .adjacent li + li {
      border-top: 0;
    }
    .next {
      grid-column: 2;
      text-align: right;
    }
  }
</style>
