---
// Home intro colophon: one line, KL clock · availability. Spec §3.1 item 1;
// docs/design-addendum.md §7.2 (time mono step--1, the rest sans step--1,
// ink-2).
import LiveClock from './LiveClock.astro';

interface Props {
  availability: string;
}
const { availability } = Astro.props;
---
<p class="colophon"><LiveClock /> KL <span aria-hidden="true">·</span> {availability}</p>

<style>
  .colophon {
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
</style>
