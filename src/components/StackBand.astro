---
// A flat espresso band of the main stack, scrolling slowly sideways. Pure CSS
// (transform only, runs on the compositor); the second copy is aria-hidden so
// screen readers hear the list once. Paused on hover and under reduced motion,
// where it becomes a plain scrollable row.
// Borrowed: the stack ticker from print-studio sites; the flat colour field
// from felixpeault.com.
import { skills } from '../data/about';

const items = [...skills[0].items.filter((i) => i !== 'Database design and management'), ...skills[1].items];
---
<section class="band" aria-label="Main tools">
  <div class="track">
    <ul class="set">
      {items.map((i) => <li>{i}</li>)}
    </ul>
    <ul class="set" aria-hidden="true">
      {items.map((i) => <li>{i}</li>)}
    </ul>
  </div>
</section>

<style>
  .band {
    margin-top: var(--section);
    background: var(--c-block);
    color: var(--c-block-ink);
    overflow: hidden;
    padding-block: var(--space-5);
  }
  .track {
    display: flex;
    width: max-content;
    animation: band-slide 38s linear infinite;
    will-change: transform;
  }
  .set {
    list-style: none;
    display: flex;
    flex: none;
  }
  .set li {
    font-family: var(--font-sans);
    font-stretch: var(--display-stretch);
    font-weight: 800;
    text-transform: uppercase;
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    padding-inline: var(--space-5);
    display: flex;
    align-items: center;
    gap: calc(var(--space-5) * 2);
  }
  /* A small square between the words. */
  .set li::after {
    content: '';
    width: 0.3em;
    height: 0.3em;
    background: var(--c-block-ink-2);
  }
  @keyframes band-slide {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .band:hover .track {
      animation-play-state: paused;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .band {
      overflow-x: auto;
    }
    .track {
      animation: none !important;
    }
    .set[aria-hidden='true'] {
      display: none;
    }
  }
</style>
