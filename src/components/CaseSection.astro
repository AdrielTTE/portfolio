---
// One case-study section. Renders nothing when there's no content, so a
// missing fact never shows as an empty heading (spec §3.3 honesty gate).
// One reading column, set in from the left on wide screens, separated by
// space rather than rules; a wide artifact (diagram/schema) gets the full
// right-hand span. `text` is plain frontmatter prose; `backticks` render as
// <code> (escaped first, see src/lib/inline-code.ts).
import { inlineCode } from '../lib/inline-code';

interface Props { title: string; id: string; text?: string; show?: boolean }
const { title, id, text, show } = Astro.props;
const visible = show ?? Boolean(text);
---
{visible && (
  <section class="case-section" aria-labelledby={id}>
    <h2 id={id} class="display">{title}</h2>
    <div class="content">
      {text && <p set:html={inlineCode(text)} />}
      <slot />
    </div>
  </section>
)}
<style>
  .case-section {
    margin-top: clamp(var(--space-8), 5vw + 24px, var(--space-10));
  }
  h2 {
    font-size: var(--step-4);
    margin-bottom: var(--space-4);
    max-width: 16ch;
  }
  .content {
    max-width: 62ch;
  }
  .content p {
    font-size: var(--step-1);
    line-height: 1.55;
  }
  /* Long file paths must wrap rather than push the page wider at 360px. */
  .content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }
  /* "What I'd change" reads as one bigger line. */
  h2[id='change'] + .content p {
    font-size: var(--step-2);
    line-height: 1.4;
  }
  /* A wide artifact (diagram/schema/receipts) is not prose, so it isn't
     measure-capped. */
  .content:has(:global(.arch)),
  .content:has(:global(.schema)),
  .content:has(:global(.receipts)) {
    max-width: none;
  }
  @media (min-width: 1024px) {
    .case-section {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: start;
    }
    h2 {
      grid-column: 1 / span 4;
      margin-bottom: 0;
    }
    .content {
      grid-column: 5 / span 7;
    }
    .content:has(:global(.arch)),
    .content:has(:global(.schema)),
    .content:has(:global(.receipts)) {
      grid-column: 5 / span 8;
    }
  }
</style>
