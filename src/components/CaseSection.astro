---
// One case-study section. Renders nothing when there's no content, so a
// missing fact never shows as an empty heading. Spec §3.3 honesty gate.
// Layout: docs/design-addendum.md §7.4/7.5 ledger rail — heading in the left
// rail (cols 1-3), content in cols 4-9, widened to cols 4-12 for a wide
// artifact (ArchDiagram/SchemaCard), under a full-width hairline rule.
// `text` is plain frontmatter prose; `backticks` render as <code> (escaped
// first, see src/lib/inline-code.ts).
import { inlineCode } from '../lib/inline-code';

interface Props { title: string; id: string; text?: string; show?: boolean }
const { title, id, text, show } = Astro.props;
const visible = show ?? Boolean(text);
---
{visible && (
  <section class="case-section" aria-labelledby={id}>
    <h2 id={id}>{title}</h2>
    <div class="content">
      {text && <p set:html={inlineCode(text)} />}
      <slot />
    </div>
  </section>
)}
<style>
  .case-section {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--c-rule);
  }
  h2 {
    font-size: var(--step-1);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }
  .content {
    max-width: 68ch;
  }
  .content p {
    font-size: var(--step-1);
  }
  /* Long file paths must wrap rather than push the page wider at 360px. */
  .content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }
  /* "What I'd change" reads as one bigger line, per design-addendum §7.4. */
  h2[id='change'] + .content p {
    font-size: var(--step-2);
  }
  /* A wide artifact (diagram/schema) is not prose, so it isn't measure-capped. */
  .content:has(:global(.arch)),
  .content:has(:global(.schema)) {
    max-width: none;
  }
  .content :global(.arch),
  .content :global(.schema) {
    margin-block: var(--space-7);
  }
  @media (min-width: 1024px) {
    .case-section {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: start;
    }
    h2 {
      grid-column: 1 / span 3;
      margin-bottom: 0;
    }
    .content {
      grid-column: 4 / span 6;
    }
    .content:has(:global(.arch)),
    .content:has(:global(.schema)) {
      grid-column: 4 / span 9;
    }
  }
</style>
