---
// What I build, drawn as the system it is: a web app and a mobile app both
// talk to an API, which owns the database. Each client node and the API are
// tabs (Web apps · Mobile apps · APIs & data); choosing one lights its path
// through the stack and shows the offer line, stack and the real projects
// that prove it. Tabs without projects don't render. Spec §3.1 item 2,
// §5.3 item 3.
// Accessible-tabs interface: roving tabindex, arrow keys, aria-selected,
// inert inactive panels stacked in one grid cell (zero CLS). Hover on a fine
// pointer only previews a path; it never swaps the panel under the cursor.
import { offersWithProjects, type OfferId } from '../lib/offers';
import { offerCopy } from '../data/site';
import type { WorkEntry } from '../lib/work';

interface Props { projects: WorkEntry[] }
// Visual/reading order of the map: both clients first, then the API.
const MAP_ORDER: OfferId[] = ['webapps', 'mobile', 'apis'];
const NODE: Record<OfferId, { label: string; sub: string }> = {
  webapps: { label: 'Web app', sub: 'in the browser' },
  mobile: { label: 'Mobile app', sub: 'Flutter · iOS + Android' },
  apis: { label: 'API', sub: 'ASP.NET Core · C#' },
};
const offers = offersWithProjects(Astro.props.projects).sort(
  (a, b) => MAP_ORDER.indexOf(a.id) - MAP_ORDER.indexOf(b.id),
);
const first = offers[0]?.id;
---
{offers.length > 0 && (
  <section class="offers" aria-labelledby="offers-h">
    <h2 id="offers-h">What I build</h2>
    <div class="sys" data-on={first} role="tablist" aria-labelledby="offers-h">
        {offers.map((o) => (
          <button
            role="tab"
            class={`node node--${o.id}`}
            data-node={o.id}
            id={`tab-${o.id}`}
            aria-controls={`panel-${o.id}`}
            aria-selected={o.id === first ? 'true' : 'false'}
            tabindex={o.id === first ? 0 : -1}
          >
            <span class="n-label">{NODE[o.id].label}</span>
            <span class="n-sub">{NODE[o.id].sub}</span>
          </button>
        ))}
      <div class="node node--db" aria-hidden="true">
        <span class="n-label">Database</span>
        <span class="n-sub">SQL · Firestore</span>
      </div>
      <span class="wire w-web" aria-hidden="true"></span>
      <span class="wire w-mob" aria-hidden="true"></span>
      <span class="wire w-join" aria-hidden="true"><i class="dot"></i></span>
      <span class="wire w-db" aria-hidden="true"><i class="dot"></i></span>
    </div>
    <div class="panels">
      {offers.map((o) => (
        <div
          class={`panel${o.id === first ? ' is-active' : ''}`}
          role="tabpanel"
          id={`panel-${o.id}`}
          aria-labelledby={`tab-${o.id}`}
          inert={o.id !== first ? true : undefined}
          tabindex="0"
        >
          <p class="line">{offerCopy[o.id].line}</p>
          <p class="stack">{offerCopy[o.id].stack.join(' · ')}</p>
          <ul class="proof">
            {o.projects.map((p) => <li><a href={`/work/${p.id}/`}>{p.data.title} <span class="arrow" aria-hidden="true">→</span></a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
)}

<script src="../scripts/offers.ts"></script>

<style>
  .offers > h2 {
    font-size: var(--step-0);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  /* The map. Phones: the two clients side by side, their wires merging
     down into the API, then the database. */
  .sys {
    --wire: 1.5px;
    --g: 12px;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 28px auto 24px auto;
    column-gap: var(--g);
  }
  .node {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    gap: 2px;
    min-height: 64px;
    padding: 10px 14px;
    text-align: left;
    font: inherit;
    color: var(--c-ink);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: 8px;
  }
  button.node {
    cursor: pointer;
  }
  .n-label {
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .n-sub {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
  .node--webapps { grid-area: 1 / 1; }
  .node--mobile { grid-area: 1 / 2; }
  .node--apis { grid-area: 3 / 1 / 4 / 3; }
  .node--db { grid-area: 5 / 1 / 6 / 3; }

  /* Wires: a rule-coloured line (::before) under an accent copy (::after)
     that fades in when its path is lit. Geometry comes from --in/--bw/--br. */
  .wire {
    position: relative;
    pointer-events: none;
  }
  .wire::before,
  .wire::after {
    content: '';
    position: absolute;
    inset: var(--in);
    border: 0 solid color-mix(in oklab, var(--c-ink-2) 60%, var(--c-bg));
    border-width: var(--bw);
    border-radius: var(--br, 0);
  }
  .wire::after {
    border-color: var(--c-accent);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-enter);
  }
  /* └ from the web node's centre to the middle, ┘ from mobile's. */
  .w-web {
    grid-area: 2 / 1;
    --in: 0 calc(var(--g) / -2) 50% 50%;
    --bw: 0 0 var(--wire) var(--wire);
    --br: 0 0 0 8px;
  }
  .w-mob {
    grid-area: 2 / 2;
    --in: 0 50% 50% calc(var(--g) / -2);
    --bw: 0 var(--wire) var(--wire) 0;
    --br: 0 0 8px 0;
  }
  .w-join {
    grid-area: 2 / 1 / 3 / 3;
    --in: 50% auto 0 calc(50% - var(--wire) / 2);
    --bw: 0 0 0 var(--wire);
  }
  .w-db {
    grid-area: 4 / 1 / 5 / 3;
    --in: 0 auto 0 calc(50% - var(--wire) / 2);
    --bw: 0 0 0 var(--wire);
  }
  .dot {
    display: none;
  }

  /* Lit paths. A client lights its own wire, the join, the API and the
     database; the API lights itself and the database. */
  .sys[data-on='webapps'] :is(.w-web, .w-join, .w-db)::after,
  .sys[data-on='mobile'] :is(.w-mob, .w-join, .w-db)::after,
  .sys[data-on='apis'] .w-db::after {
    opacity: 1;
  }
  .sys[data-on='webapps'] :is(.node--webapps, .node--apis, .node--db),
  .sys[data-on='mobile'] :is(.node--mobile, .node--apis, .node--db),
  .sys[data-on='apis'] :is(.node--apis, .node--db) {
    border-color: var(--c-accent);
  }
  .node[aria-selected='true'] {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-accent-ink);
  }
  .node[aria-selected='true'] .n-sub {
    color: var(--c-accent-ink);
  }
  .node:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 3px;
  }

  /* Wide enough for one row: clients stacked left, wires merging right into
     the API, then the database. */
  @media (min-width: 720px) {
    .sys {
      grid-template-columns: minmax(0, 1fr) 48px minmax(0, 1fr) 36px minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 0;
      row-gap: var(--g);
    }
    .node--webapps { grid-area: 1 / 1; }
    .node--mobile { grid-area: 2 / 1; }
    .node--apis { grid-area: 1 / 3 / 3 / 4; align-self: center; }
    .node--db { grid-area: 1 / 5 / 3 / 6; align-self: center; }
    /* ┐ and ┘ into the middle, then one line into the API. */
    .w-web {
      grid-area: 1 / 2;
      --in: 50% 50% calc(var(--g) / -2) 0;
      --bw: var(--wire) var(--wire) 0 0;
      --br: 0 8px 0 0;
    }
    .w-mob {
      grid-area: 2 / 2;
      --in: calc(var(--g) / -2) 50% 50% 0;
      --bw: 0 var(--wire) var(--wire) 0;
      --br: 0 0 8px 0;
    }
    .w-join {
      grid-area: 1 / 2 / 3 / 3;
      --in: calc(50% - var(--wire) / 2) 0 auto 50%;
      --bw: var(--wire) 0 0 0;
    }
    .w-db {
      grid-area: 1 / 4 / 3 / 5;
      --in: calc(50% - var(--wire) / 2) 0 auto 0;
      --bw: var(--wire) 0 0 0;
    }
  }

  /* Desktop, fine pointer, motion allowed: a request dot runs along the lit
     horizontal wires each time a path lights (transform + opacity only).
     offers.ts toggles .run to restart it. Decorative, so touch never sees
     it and reduced motion never runs it. */
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .dot {
      display: block;
      position: absolute;
      left: 0;
      top: calc(50% - 3px);
      width: 100%;
      height: 6px;
      opacity: 0;
    }
    .dot::before {
      content: '';
      display: block;
      width: 6px;
      height: 6px;
      margin-left: -3px;
      border-radius: 50%;
      background: var(--c-accent);
    }
    .sys.run[data-on='webapps'] :is(.w-join, .w-db) .dot,
    .sys.run[data-on='mobile'] :is(.w-join, .w-db) .dot,
    .sys.run[data-on='apis'] .w-db .dot {
      animation: travel 520ms var(--ease-exit) both;
    }
    .sys.run[data-on='webapps'] .w-db .dot,
    .sys.run[data-on='mobile'] .w-db .dot {
      animation-delay: 440ms;
    }
  }
  @keyframes travel {
    0% { transform: translateX(0); opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translateX(100%); opacity: 0; }
  }

  /* Panels stack in one grid cell so the container height is the tallest
     panel and switching never shifts layout (design-addendum §6.2). */
  .panels {
    display: grid;
    margin-top: var(--space-5);
  }
  .panel {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-base) var(--ease-enter), visibility 0s var(--dur-base);
  }
  .panel.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dur-base) var(--ease-enter), visibility 0s;
  }
  .panel.entering {
    animation: panel-in var(--dur-base) var(--ease-enter);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .panel:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 4px;
  }
  .line {
    font-size: var(--step-2);
    line-height: 1.35;
    max-width: 34ch;
  }
  .stack {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
    margin-top: 8px;
  }
  .proof {
    list-style: none;
    padding: 0;
    margin-top: 4px;
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }
  .proof a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 500;
  }
  .proof .arrow {
    transition: transform var(--dur-fast) var(--ease-enter);
  }
  @media (hover: hover) and (pointer: fine) {
    button.node:not([aria-selected='true']):hover .n-label {
      color: var(--c-accent);
    }
    .proof a:hover {
      color: var(--c-accent);
    }
    .proof a:hover .arrow {
      transform: translateX(3px);
    }
  }
</style>
