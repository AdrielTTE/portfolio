---
// Case-study facts as a quiet colophon: plain labels over plain values, no
// boxes. Omits Team/Live when absent.
interface Props {
  role: string;
  team?: string;
  scope: string;
  stack: string[];
  year: number;
  repo?: string;
  live?: string;
  download?: string;
}
const { role, team, scope, stack, year, repo, live, download } = Astro.props;
const facts = [
  { k: 'Role', v: role },
  team ? { k: 'Team', v: team } : null,
  { k: 'Scope', v: `${scope}, ${year}` },
  { k: 'Stack', v: stack.join(', ') },
].filter((f): f is { k: string; v: string } => f !== null);
---
<dl class="facts-row">
  {facts.map((f) => (
    <div class="fact">
      <dt>{f.k}</dt>
      <dd>{f.v}</dd>
    </div>
  ))}
  {(repo || live || download) && (
    <div class="fact fact-links">
      <dt>Links</dt>
      <dd>
        {repo && <a href={repo} rel="noopener" target="_blank">Code on GitHub <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a>}
        {download && <a href={download} rel="noopener" target="_blank">Download for Android <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a>}
        {live && <a href={live} rel="noopener" target="_blank">Live site <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (opens in new tab)</span></a>}
      </dd>
    </div>
  )}
</dl>

<style>
  .facts-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--gutter);
    margin-top: var(--space-7);
  }
  .fact-links dd {
    display: flex;
    flex-wrap: wrap;
    column-gap: 16px;
  }
  /* 44px tap target; the negative block margin keeps the row's height. */
  .fact-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -10px;
    font-weight: 500;
  }
  dt {
    font-size: var(--step--1);
    color: var(--c-ink-2);
    margin-bottom: 2px;
  }
  @media (min-width: 1024px) {
    .facts-row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .fact {
      grid-column: span 3;
    }
  }
</style>
