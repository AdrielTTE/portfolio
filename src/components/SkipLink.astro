---
// First focusable element on every page. See docs/design-spec.md §5.0.
---
<a class="skip-link" href="#main">Skip to content</a>

<style>
  .skip-link {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    padding: 12px 16px;
    background: var(--c-bg);
    color: var(--c-ink);
    outline: 2px solid var(--c-ink);
    outline-offset: -2px;
    font-weight: 500;
    transform: translateY(-100%);
    transition: transform 160ms var(--ease-enter);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
