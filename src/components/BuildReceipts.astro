---
// Real numbers measured at build (scripts/receipts.mjs fills these in). Each
// receipt stays hidden unless a value was injected. Shown on the This site
// case study, set large in the display voice.
const items = [
  { key: 'page-kb', label: 'Home page, gzip', unit: 'KB' },
  { key: 'js-kb', label: 'JavaScript, whole site, gzip', unit: 'KB' },
  { key: 'lh-perf', label: 'Lighthouse performance, mobile', unit: '/100' },
];
---
<div class="receipts">
  <dl>
    {items.map((i) => (
      <div class="receipt" data-receipt-wrap={i.key} hidden>
        <dt>{i.label}</dt>
        <dd class="display"><span data-receipt={i.key} hidden></span><span class="unit">{i.unit}</span></dd>
      </div>
    ))}
  </dl>
  <p class="sha" data-receipt-wrap="sha" hidden>Measured on commit <a data-receipt="sha" data-href-template="https://github.com/AdrielTTE/portfolio/commit/{v}" hidden></a>.</p>
</div>

<style>
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-5) var(--gutter);
  }
  dt {
    color: var(--c-ink-2);
  }
  dd {
    margin-top: var(--space-1);
    font-size: var(--step-6);
    color: var(--c-display);
    font-variant-numeric: tabular-nums;
  }
  .unit {
    font-size: 0.4em;
    margin-left: 0.1em;
  }
  .sha {
    margin-top: var(--space-5);
    color: var(--c-ink-2);
  }
</style>
