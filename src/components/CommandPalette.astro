---
// ⌘K palette. Native <dialog> gives the focus trap, Esc handling and the
// backdrop. Markup/ARIA/interfaces: task-8 brief. Visuals: design-addendum
// §7.6 (layout at 360/1440, motion, colours).
import { getCollection } from 'astro:content';
import { sortByOrder } from '../lib/work';
import { site } from '../data/site';
import type { Command } from '../lib/palette';

const work = sortByOrder(await getCollection('work'));
const commands: Command[] = [
  { id: 'home', label: 'Home', group: 'Pages', href: '/' },
  { id: 'work', label: 'Work', group: 'Pages', href: '/#work' },
  { id: 'about', label: 'About', group: 'Pages', href: '/about/' },
  { id: 'contact', label: 'Start a project', group: 'Pages', href: '/contact/', keywords: 'contact hire email' },
  ...work.map((w) => ({
    id: w.id,
    label: w.data.title,
    group: 'Projects' as const,
    href: `/work/${w.id}/`,
    keywords: w.data.stack.join(' '),
  })),
  { id: 'copy-email', label: 'Copy email address', group: 'Actions', action: 'copy-email', keywords: site.email },
  { id: 'theme', label: 'Toggle theme', group: 'Actions', action: 'toggle-theme', keywords: 'dark light' },
  { id: 'github', label: 'Open GitHub', group: 'Actions', href: site.github },
  { id: 'linkedin', label: 'Open LinkedIn', group: 'Actions', href: site.linkedin },
];
---
<dialog id="palette" aria-label="Command menu">
  <div class="panel">
    <div class="input-row">
      <input
        id="palette-q"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        placeholder="Search or jump to…"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="esc-hint" aria-hidden="true">esc</kbd>
      <button type="button" class="close-btn" data-palette-close aria-label="Close command menu">Close</button>
    </div>
    <ul id="palette-list" role="listbox" aria-label="Results"></ul>
    <p id="palette-empty" role="status" aria-live="polite"></p>
    <p id="palette-status" class="visually-hidden" role="status" aria-live="polite"></p>
    <span class="hl" aria-hidden="true"></span>
    <div class="footer-hints" aria-hidden="true">
      <span><kbd>↑↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
    <div class="grabber" data-grab aria-hidden="true"><span></span></div>
  </div>
  <script type="application/json" id="palette-data" set:html={JSON.stringify(commands)} />
  <span id="palette-email" hidden>{site.email}</span>
</dialog>

<script src="../scripts/palette.ts"></script>

<style>
  dialog {
    padding: 0;
    border: 1px solid var(--c-rule);
    border-radius: 2px;
    width: min(640px, calc(100vw - 32px));
    /* Tall enough for every command (11 items + 3 group labels, ~590px) at a
       900px-tall desktop viewport; the list scrolls below that. */
    --pal-max: calc(88dvh - 24px);
    max-height: var(--pal-max);
    margin: 12vh auto auto;
    background: var(--c-bg);
    color: var(--c-ink);
    /* The list is the only thing that scrolls. A dialog scrolls by default,
       which doubled the scrollbar whenever the rows were a few px too tall. */
    overflow: hidden;
  }
  /* The palette grows out of whatever opened it (--ox/--oy are set from the
     trigger's position, top centre for the keyboard) and shrinks back into it.
     The spring is critically damped: it faded in, so it should not bounce. */
  dialog[open] {
    animation: pal-in 380ms var(--spring);
    transform-origin: var(--ox, 50%) var(--oy, 0);
    transform: translateY(var(--dy, 0px));
  }
  dialog::backdrop {
    /* --p (0 to 1) is how far the sheet has been dragged away; it thins the
       scrim as it goes. The custom property is inherited from the dialog. */
    background: rgb(29 23 18 / calc(0.45 * (1 - var(--p, 0))));
    animation: fade var(--dur-base) var(--ease-enter);
  }
  :root[data-theme='dark'] dialog::backdrop {
    background: rgb(0 0 0 / calc(0.6 * (1 - var(--p, 0))));
  }
  /* A soft blur behind the scrim, on desktop only: a full-screen blur is too
     heavy to animate on a mid-range phone. The blur itself never animates;
     only the scrim's opacity does. */
  @media (hover: hover) and (pointer: fine) {
    dialog::backdrop {
      backdrop-filter: blur(5px);
    }
  }
  /* Exit (palette.ts adds .closing, closes on animationend). `forwards`
     holds the end state for the frame before dialog.close(). */
  dialog.closing {
    animation: pal-out var(--dur-fast) var(--ease-exit) forwards;
  }
  dialog.closing::backdrop {
    animation: fade-out var(--dur-fast) var(--ease-exit) forwards;
  }
  @keyframes pal-out {
    to {
      opacity: 0;
      transform: scale(0.92);
    }
  }
  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }
  @keyframes pal-in {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
  }
  @keyframes pal-sheet-in {
    from {
      opacity: 0;
      transform: translateY(-28px);
    }
  }
  @keyframes pal-sheet-out {
    to {
      opacity: 0;
      transform: translateY(-28px);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @media (max-width: 599px) {
    dialog {
      width: calc(100% - 16px);
      margin: 8px auto auto;
      --pal-max: calc(100dvh - 16px);
    }
    /* On a phone it is a sheet that drops from the header: it comes in from
       the top, so it leaves to the top, and can be dragged up to dismiss. */
    dialog[open] {
      animation-name: pal-sheet-in;
    }
    dialog.closing {
      animation-name: pal-sheet-out;
    }
    dialog.dragging {
      transition: none;
    }
    dialog.settling {
      transition: transform var(--dur-slow) var(--spring);
    }
  }
  .grabber {
    display: none;
  }
  @media (max-width: 599px) {
    .grabber {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 28px;
      touch-action: none;
      cursor: grab;
      border-top: 1px solid var(--c-rule);
    }
    .grabber span {
      width: 36px;
      height: 4px;
      border-radius: 2px;
      background: var(--c-rule);
    }
  }

  /* A column: input row and hints keep their own height, the list takes
     whatever is left of the dialog's max height and scrolls inside it. */
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: var(--pal-max);
  }
  .panel > * {
    flex: none;
  }

  .input-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-inline-end: 12px;
    border-bottom: 1px solid var(--c-rule);
  }
  input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: var(--step-1);
    padding: 18px 16px;
    border: 0;
    background: none;
    color: inherit;
  }
  input:focus {
    outline: none;
  }
  @media (max-width: 599px) {
    input {
      padding-block: 16px;
    }
  }
  .esc-hint {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
    border: 1px solid var(--c-rule);
    border-radius: 4px;
    padding: 2px 6px;
  }
  .close-btn {
    display: none;
    flex-shrink: 0;
    font: inherit;
    font-size: var(--step-0);
    background: none;
    border: 0;
    color: var(--c-ink);
    cursor: pointer;
  }
  @media (pointer: coarse) {
    .esc-hint {
      display: none;
    }
    .close-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
    }
  }

  .panel > ul {
    list-style: none;
    margin: 0;
    padding: 6px;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    /* Reaching the end of the list must not scroll the page behind it. */
    overscroll-behavior: contain;
    position: relative;
    /* No visible scrollbar: the highlight is laid over the whole panel and ran
       underneath it, and with it showing the rows were narrower than the
       highlight. Wheel, touch and arrow keys still scroll; a half-cut row at
       the bottom says there is more. */
    scrollbar-width: none;
  }
  .panel > ul::-webkit-scrollbar {
    display: none;
  }
  :global(#palette-list .grp-label) {
    padding: 8px 12px 4px;
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
  :global(#palette-list .item) {
    position: relative;
    z-index: 1;
    min-height: 44px;
    padding-inline: 12px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    font-size: var(--step-0);
  }
  :global(#palette-list .item .hint),
  :global(#palette-list .item .grp) {
    margin-left: auto;
  }
  /* The active row says "press enter" instead of wearing a stripe. Desktop only:
     touch has no Enter key. */
  @media (hover: hover) and (min-width: 600px) {
    :global(#palette-list .item[aria-selected="true"])::after {
      content: "↵";
      flex-shrink: 0;
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--c-ink-2);
    }
  }
  :global(#palette-list .item .hint),
  :global(#palette-list .item .grp) {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
    white-space: nowrap;
  }
  @media (max-width: 599px) {
    :global(#palette-list .item) {
      min-height: 48px;
    }
    :global(#palette-list .item .hint),
    :global(#palette-list .item .grp) {
      display: none;
    }
  }

  .hl {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 0;
    height: 44px;
    border-radius: 4px;
    background: var(--c-bg-2);
    transition: transform var(--dur-fast) var(--ease-enter);
    pointer-events: none;
  }
  @media (max-width: 599px) {
    .hl {
      height: 48px;
    }
  }

  /* Always in the tree so the live region speaks when a query stops
     matching (a hidden region may not); it collapses while empty. */
  #palette-empty {
    padding: 16px;
    color: var(--c-ink-2);
  }
  #palette-empty:empty {
    padding: 0;
  }
  :global(#palette-list .item.is-done .hint) {
    color: var(--c-ink);
  }

  .footer-hints {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 36px;
    padding-inline: 12px;
    border-top: 1px solid var(--c-rule);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
  @media (pointer: coarse) {
    .footer-hints {
      display: none;
    }
  }
</style>
