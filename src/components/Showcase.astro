---
// Selected work as a scroll scene. On a wide screen with a fine pointer the
// section pins and scrubs: each project's phone cycles through its real
// screens, then the next project slides in (showcase.ts). On phones, and
// without JS or with reduced motion, it is a plain stack: title, phones, facts.
// Borrowed: the pinned device scene from product sites (Linear, Arc); the flat
// colour field from felixpeault.com.
import { Image } from 'astro:assets';
import type { WorkEntry } from '../lib/work';
import { sortByOrder } from '../lib/work';

interface Props { projects: WorkEntry[] }
const projects = sortByOrder(Astro.props.projects.filter((p) => p.data.shots.length > 0));
---
{projects.length > 0 && (
  <section class="scene" id="showcase" aria-labelledby="scene-h" data-scene data-glow>
    <h2 id="scene-h" class="visually-hidden">Selected work</h2>
    <div class="pin">
      {projects.map((p) => (
        <article class="proj" data-proj>
          <h3 class="name display">{p.data.title}</h3>
          <div class="phones" data-phones>
            {p.data.shots.slice(0, 2).map((s, i) => (
              <div class="phone" data-phone>
                <div class="screen">
                  <Image
                    src={s.src}
                    alt={s.alt}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 900px) 22vw, 42vw"
                    loading="lazy"
                    data-shot={i}
                  />
                </div>
              </div>
            ))}
          </div>
          <div class="facts">
            <p class="sum">{p.data.summary}</p>
            <p class="meta">{p.data.scope}, {p.data.year}. {p.data.stack.join(', ')}.</p>
            <a class="more" href={`/work/${p.id}/`}>Read the case study <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
      <div class="bar" aria-hidden="true"><span data-bar></span></div>
    </div>
  </section>
)}

<script src="../scripts/showcase.ts"></script>

<style>
  .scene {
    margin-top: var(--section);
    background: var(--c-block);
    color: var(--c-block-ink);
    --c-ink: var(--c-block-ink);
    --c-ink-2: var(--c-block-ink-2);
    --c-focus: var(--c-block-ink);
    overflow: clip;
  }

  /* Stacked layout (phones, no JS, reduced motion). */
  .pin {
    display: grid;
    gap: var(--space-9);
    padding: var(--space-8) var(--margin);
    max-width: 1600px;
    margin-inline: auto;
  }
  .proj {
    display: grid;
    gap: var(--space-5);
  }
  .name {
    font-size: var(--step-6);
    color: var(--c-block-ink);
  }
  .phones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    max-width: 560px;
  }
  .phone {
    padding: 6px;
    border-radius: 22px;
    background: #0b0a09;
  }
  .screen {
    position: relative;
    aspect-ratio: 1344 / 2992;
    border-radius: 17px;
    overflow: hidden;
    background: #14100c;
  }
  .screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .facts {
    display: grid;
    gap: var(--space-3);
    max-width: 40ch;
  }
  .sum {
    font-size: var(--step-2);
    line-height: 1.3;
  }
  .meta {
    color: var(--c-block-ink-2);
  }
  .more {
    font-weight: 600;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .bar {
    display: none;
  }

  /* Wide, still stacked: three columns per project. */
  @media (min-width: 900px) {
    .proj {
      grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
      align-items: center;
      gap: var(--gutter);
    }
    .phones {
      max-width: none;
    }
  }

  /* Pinned layout: showcase.ts adds .pinned when it takes over. */
  .scene.pinned .pin {
    display: block;
    position: relative;
    height: 100vh;
    height: 100svh;
    padding: 0;
    overflow: hidden;
  }
  .scene.pinned .proj {
    position: absolute;
    inset: 0;
    padding: calc(var(--header-h) + var(--space-5)) var(--margin) var(--space-7);
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--gutter);
  }
  .scene.pinned .name {
    font-size: clamp(88px, 12vw, 240px);
    line-height: 0.8;
  }
  .scene.pinned .phones {
    display: block;
    position: relative;
    width: min(23vw, 36vh);
    max-width: none;
  }
  .scene.pinned .phone {
    padding: 8px;
    border-radius: 34px;
  }
  .scene.pinned .phone:not(:first-child) {
    position: absolute;
    inset: 0;
  }
  .scene.pinned .screen {
    border-radius: 27px;
  }
  .scene.pinned .facts {
    justify-self: end;
    max-width: 30ch;
  }
  .scene.pinned .bar {
    display: block;
    position: absolute;
    left: var(--margin);
    right: var(--margin);
    bottom: var(--space-5);
    height: 2px;
    background: color-mix(in oklab, var(--c-block-ink) 25%, transparent);
  }
  .scene.pinned .bar span {
    display: block;
    height: 100%;
    background: var(--c-block-ink);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
</style>
