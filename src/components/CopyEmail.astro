---
// docs/design-spec.md §5.4. `variant="button"` is the home secondary button
// (docs/design-addendum.md §6.1): same 48px box as the primary CTA.
// Both labels share one grid cell, so the box is as wide as the longer one
// and never jumps on "Copied". No ids: the script wires every instance.
interface Props {
  email: string;
  label?: string;
  variant?: 'inline' | 'button';
}
const { email, label = 'Copy', variant = 'inline' } = Astro.props;
---
<span class={`copy-email copy-email--${variant}`}>
  <button type="button" class="copy-button" data-email={email} aria-label={label === 'Copy' ? 'Copy email address' : `${label} address`}>
    <span class="labels" aria-hidden="true">
      <span class="idle">{label}</span>
      <span class="done">Copied</span>
    </span>
  </button>
  <span class="visually-hidden copy-status" role="status" aria-live="polite"></span>
</span>

<style>
  .copy-button {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--c-ink);
    background: none;
    border: 1px solid var(--c-ink-2);
    border-radius: 2px;
    padding-inline: 12px;
    min-height: 44px;
    cursor: pointer;
    margin-left: 8px;
  }
  .copy-email--button .copy-button {
    font-size: var(--step-0);
    font-weight: 600;
    min-height: 52px;
    padding-inline: 22px;
    border-color: var(--c-ink);
    margin-left: 0;
    white-space: nowrap;
  }
  .labels {
    display: inline-grid;
  }
  .labels > span {
    grid-area: 1 / 1;
    transition: opacity var(--dur-fast) var(--ease-enter);
  }
  .done,
  .copy-button.is-copied .idle {
    opacity: 0;
  }
  .copy-button.is-copied .done {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .copy-button:hover {
      background: var(--c-bg-2);
    }
  }
  .copy-button:active {
    translate: 0 1px;
  }
</style>

<script src="../scripts/copy-email.ts"></script>
