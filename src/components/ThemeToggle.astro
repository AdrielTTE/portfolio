---
// Cycles Auto -> Light -> Dark. See docs/design-spec.md §8 (Components table).
---
<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label="Colour theme: Auto"
>
  <span aria-hidden="true">Auto</span>
</button>

<script src="../scripts/theme-toggle.ts"></script>

<style>
  .theme-toggle {
    background: none;
    border: none;
    padding-block: 12px;
    min-height: 44px;
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink);
    cursor: pointer;
  }
  .theme-toggle:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .theme-toggle:active {
    translate: 0 1px;
  }
</style>
