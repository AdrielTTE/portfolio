---
// Cycles Auto -> Light -> Dark. See docs/design-spec.md §8 (Components table).
// Unboxed like the other header words, with a 44px hit area. The glyph follows the root's data-theme in CSS, so it is right
// before any script runs: half-filled = Auto, open = Light, solid = Dark. The
// text label shows from 600px up; below that the icon stands alone.
---
<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label="Colour theme: Auto"
>
  <svg class="theme-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
    <circle cx="8" cy="8" r="6.25" />
    <path class="half" d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" />
  </svg>
  <span class="theme-label" aria-hidden="true">Auto</span>
</button>

<script src="../scripts/theme-toggle.ts"></script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    min-width: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 500;
    color: var(--c-ink);
    cursor: pointer;
  }
  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover .theme-label {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
  }
  .theme-toggle:active {
    translate: 0 1px;
  }
  /* "Light" is one glyph longer than "Auto"/"Dark": reserve it so the nav
     never shifts on toggle. */
  .theme-label {
    min-width: 5ch;
    text-align: left;
  }
  .theme-icon {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .theme-icon circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .theme-icon .half {
    fill: currentColor;
  }
  :global(:root[data-theme='light']) .theme-icon .half {
    fill: none;
  }
  :global(:root[data-theme='dark']) .theme-icon circle {
    fill: currentColor;
  }
  /* Narrow screens: icon only, a true 44x44 box (addendum §7.1). */
  @media (max-width: 599px) {
    .theme-label {
      display: none;
    }
  }
</style>
