---
// The tools I use, as a tray of chips you can pick up and throw around
// (toolbox.ts). On touch screens and under reduced motion they are a plain
// wrapped list, so nothing fights page scrolling.
// Borrowed: the draggable-objects idea from playful studio sites; flat chips
// in the house condensed display voice.
import { skills } from '../data/about';

const main = skills[0].items.filter((i) => i !== 'Database design and management');
const rest = [...skills[1].items, ...skills[2].items];
---
<section class="toolbox" aria-labelledby="toolbox-h">
  <div class="head">
    <h2 id="toolbox-h" class="display">Toolbox</h2>
    <p class="hint" data-hint hidden>Pick them up. Throw them around.</p>
  </div>
  <ul class="tray" data-tray>
    {main.map((t) => <li class="chip main" data-chip>{t}</li>)}
    {rest.map((t) => <li class="chip" data-chip>{t}</li>)}
  </ul>
</section>

<script src="../scripts/toolbox.ts"></script>

<style>
  .toolbox {
    display: grid;
    gap: var(--space-6);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }
  h2 {
    font-size: var(--step-4);
    color: var(--c-ink);
  }
  .hint {
    color: var(--c-ink-2);
  }
  .tray {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-content: flex-start;
    position: relative;
  }
  .chip {
    padding: 0.35em 0.8em 0.4em;
    border: 2px solid var(--c-ink);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-stretch: var(--display-stretch);
    font-weight: 800;
    text-transform: uppercase;
    font-size: var(--step-3);
    line-height: 1;
    background: var(--c-bg);
    color: var(--c-ink);
    user-select: none;
    -webkit-user-select: none;
  }
  .chip.main {
    background: var(--c-block);
    border-color: var(--c-block);
    color: var(--c-block-ink);
  }
  /* Draggable mode: a roomy tray with a hand cursor. */
  .tray.live {
    min-height: clamp(260px, 30vw, 420px);
    padding: var(--space-4);
    border: 1px dashed var(--c-rule);
  }
  .tray.live .chip {
    cursor: grab;
    touch-action: none;
  }
  .tray.live .chip:active {
    cursor: grabbing;
  }
</style>
