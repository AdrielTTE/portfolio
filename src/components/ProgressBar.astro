---
// The one colour device on the site: a scroll-position rule that is also a
// draggable scrubber. docs/design-spec.md §6.4.
---
<div
  class="progress"
  id="progress"
  role="scrollbar"
  aria-controls="main"
  aria-orientation="horizontal"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label="Page position"
  tabindex="-1"
  style="view-transition-name: progress"
>
  <div class="track"></div>
  <div class="fill"></div>
  <div class="knob"></div>
</div>

<script src="../scripts/progress.ts"></script>

<style>
  .progress {
    position: relative;
    container-type: inline-size;
    /* The knob sits half past the end at 100%; keep it from adding a horizontal scrollbar. */
    overflow-x: clip;
    height: 2px;
    cursor: ew-resize;
    touch-action: none;
  }
  .progress::before {
    content: '';
    position: absolute;
    inset: -6px 0 -10px;
  }
  .track,
  .fill {
    transform-origin: left top;
  }
  .track {
    position: absolute;
    inset: 0;
    background: var(--c-rule);
  }
  .fill {
    position: absolute;
    inset: 0;
    background: var(--c-accent);
    transform: scaleX(0);
  }
  .knob {
    position: absolute;
    top: 50%;
    width: 10px;
    height: 10px;
    background: var(--c-accent);
    opacity: 0;
    translate: -5px -50%;
  }

  /* animation-timeline lives in its own higher-specificity rule on purpose: the
     build minifier folds it into the `animation` shorthand, which browsers
     reject, leaving the bar dead. Keep the longhands split. */
  @supports (animation-timeline: scroll()) {
    .fill {
      animation-name: progress-fill;
      animation-timing-function: linear;
      animation-fill-mode: both;
    }
    .knob {
      animation-name: progress-knob;
      animation-timing-function: linear;
      animation-fill-mode: both;
    }
    .progress .fill,
    .progress .knob {
      animation-timeline: scroll(root);
    }
  }
  @keyframes progress-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes progress-knob {
    from {
      translate: -5px -50%;
    }
    to {
      translate: calc(100cqw - 5px) -50%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .track,
    .fill {
      transition: scale 160ms var(--ease-enter);
    }
    .knob {
      transition: opacity 160ms var(--ease-enter);
    }
  }
  .progress:hover .track,
  .progress:hover .fill,
  .progress.drag .track,
  .progress.drag .fill {
    scale: 1 2;
  }
  .progress:hover .knob,
  .progress.drag .knob {
    opacity: 1;
  }
</style>
