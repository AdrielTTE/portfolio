---
// The lead project, shown large at the top of the Work section: a stage in the
// project's own colour, two real screens standing straight and cropped by the
// stage's bottom edge, and one clear way in. The rest of the work stays a
// quiet list below it.
// Borrowed: the device-cropped-by-the-frame feature from product studios'
// case-study heroes; kept to two untilted screens, no scroll-linked motion.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { WorkEntry } from '../lib/work';

interface Props { project: WorkEntry }
const { project } = Astro.props;
const { title, summary, scope, year, stack, stage, accent, shots } = project.data;
const front = shots[0];
const back = shots[3] ?? shots[1];
const vars = `--stage:${stage ?? '#14161f'};--accent:${accent ?? '#f3f4f2'}`;
---
<a class="lead" href={`/work/${project.id}/`} style={vars}>
  <div class="copy">
    <h3 class="title display">{title}</h3>
    <p class="sum">{summary}</p>
    <p class="meta">{scope}, {year}. {stack.join(', ')}.</p>
    <span class="cta">View the case study <span class="arrow" aria-hidden="true"><Icon name="arrow-right" /></span></span>
  </div>
  {front && (
    <div class="devices" aria-hidden="true">
      {back && (
        <div class="phone back"><div class="screen"><Image src={back.src} alt="" widths={[260, 390, 520]} sizes="(min-width: 900px) 260px, 50vw" loading="lazy" decoding="async" /></div></div>
      )}
      <div class="phone front"><div class="screen"><Image src={front.src} alt="" widths={[260, 390, 520]} sizes="(min-width: 900px) 280px, 60vw" loading="lazy" decoding="async" /></div></div>
    </div>
  )}
</a>

<style>
  .lead {
    display: grid;
    position: relative;
    overflow: hidden;
    margin-bottom: var(--space-8);
    border-radius: var(--radius-2);
    background: var(--stage);
    color: #f3f4f2;
    text-decoration: none;
    --c-focus: #f3f4f2;
  }
  .copy {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: clamp(var(--space-6), 5vw, var(--space-9));
  }
  .title {
    font-size: var(--step-6);
    line-height: 0.85;
    color: #f3f4f2;
  }
  .sum {
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .meta {
    max-width: 44ch;
    color: color-mix(in oklab, #f3f4f2 62%, var(--stage));
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.6;
    letter-spacing: -0.01em;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: var(--space-3);
    min-height: 44px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  /* Two screens, straight, each in a device frame, cropped by the stage. */
  .devices {
    position: relative;
    height: clamp(280px, 70vw, 380px);
    margin-top: calc(var(--space-4) * -1);
  }
  .phone {
    position: absolute;
    bottom: calc(var(--space-8) * -1.4);
    width: min(46vw, 250px);
    padding: 6px;
    border-radius: var(--radius-3);
    background: #0b0a09;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1);
    transition: transform 520ms var(--ease-slide);
  }
  .screen {
    overflow: hidden;
    border-radius: calc(var(--radius-3) - 6px);
    background: #0f1117;
  }
  .screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .front {
    left: calc(50% - min(23vw, 125px));
    z-index: 2;
  }
  .back {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .lead:hover .phone {
      transform: translateY(-10px);
    }
    .lead:hover .back {
      transition-delay: 40ms;
    }
  }
  @media (min-width: 900px) {
    .lead {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      min-height: 520px;
    }
    .devices {
      height: auto;
      margin-top: 0;
    }
    .phone {
      bottom: -90px;
      width: 270px;
    }
    .front {
      left: auto;
      right: 14%;
    }
    .back {
      display: block;
      right: calc(14% + 300px);
      bottom: -170px;
      opacity: 0.92;
    }
  }
</style>
