---
// One project on the home page's Work section: a stage in the project's own
// colour, its name and summary, one clear way into the case study, and every
// screenshot in a strip you scroll through (swipe, trackpad, keyboard, or the
// arrows on a mouse). Each shot keeps its own shape: portrait screens in a
// device frame, landscape ones in a wide frame.
// Borrowed: the screens-on-a-colour-stage case-study cards of product studios,
// with a snapped horizontal strip instead of a hover preview, since hover does
// not exist on a phone.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ProjectMark from './ProjectMark.astro';
import type { WorkEntry } from '../lib/work';

interface Props { project: WorkEntry }
const { project } = Astro.props;
const { title, summary, scope, year, stack, stage, accent, shots, icon, mark, status } = project.data;
const vars = `--stage:${stage ?? '#14161f'};--accent:${accent ?? '#f3f4f2'}`;
const href = `/work/${project.id}/`;
---
<article class="block" style={vars} data-block>
  <div class="copy">
    <div class="head">
      {(icon || mark) && <div class="mk"><ProjectMark kind={mark} icon={icon} /></div>}
      <h3 class="title display"><a href={href}>{title}</a></h3>
    </div>
    <p class="sum">{summary}</p>
    {status && <p class="status"><span class="dot" aria-hidden="true"></span>{status}</p>}
    <p class="meta">{scope}, {year}. {stack.join(', ')}.</p>
    <p class="actions">
      <a class="cta" href={href}>View the case study <span class="arrow" aria-hidden="true"><Icon name="arrow-right" /></span></a>
      {shots.length > 1 && (
        <span class="nav" data-nav>
          <button type="button" class="step" data-dir="-1" aria-label={`Previous ${title} screenshot`} disabled><Icon name="arrow-left" /></button>
          <button type="button" class="step" data-dir="1" aria-label={`Next ${title} screenshot`}><Icon name="arrow-right" /></button>
        </span>
      )}
    </p>
  </div>
  {shots.length > 0 && (
    <div class="strip" role="region" aria-label={`${title} screenshots`} tabindex="0" data-strip>
      <ul class="shots">
        {shots.map((s) => {
          const wide = s.src.width > s.src.height;
          return (
            <li class:list={['shot', { wide }]} style={`--ar:${s.src.width / s.src.height}`}>
              <div class="frame">
                <Image
                  src={s.src}
                  alt={s.alt}
                  widths={wide ? [480, 720, 960] : [240, 360, 480]}
                  sizes={wide ? '(min-width: 900px) 620px, 86vw' : '(min-width: 900px) 220px, 190px'}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              {s.label && <span class="cap">{s.label}</span>}
            </li>
          );
        })}
      </ul>
    </div>
  )}
</article>

<script src="../scripts/img-fade.ts"></script>
<script src="../scripts/lightbox.ts"></script>
<script>
  import { project, rubberband } from '../lib/motion';
  // The arrows (mouse only) scroll the strip by one shot; swipe and trackpad
  // work natively. Every shot is a snap point, so at rest the strip always
  // starts exactly on a phone and the left edge never cuts one. The right edge
  // may still crop the next phone: that peek says there is more. The one catch
  // is the end of the strip: it can only scroll as far as its content, which
  // would leave the left edge mid-phone, so on desktop the script adds just
  // enough empty space after the last shot (--tail) for its last position to
  // be a phone start too. Nothing listens to scroll per frame:
  // IntersectionObserver and scrollend update the arrows, ResizeObserver
  // recomputes --tail.
  document.querySelectorAll<HTMLElement>('[data-block]').forEach((block) => {
    if (block.dataset.bound) return;
    block.dataset.bound = '1';
    const strip = block.querySelector<HTMLElement>('[data-strip]');
    const nav = block.querySelector<HTMLElement>('[data-nav]');
    const buttons = [...block.querySelectorAll<HTMLButtonElement>('button[data-dir]')];
    if (!strip || buttons.length === 0) return;
    const [prev, next] = buttons;
    const items = [...strip.querySelectorAll<HTMLElement>('.shot')];
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const wide = matchMedia('(min-width: 900px)');
    const GAP = 20;

    const stepPx = () => (items[0]?.offsetWidth ?? 240) + GAP;
    const sync = () => {
      prev.disabled = strip.scrollLeft < 4;
      next.disabled = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4;
    };

    // Desktop only: pad the end so the last scroll position starts on a phone.
    // Phones keep their centred snapping, which already centres the last shot.
    const layout = () => {
      strip.style.removeProperty('--tail');
      if (wide.matches && items.length > 0) {
        const step = stepPx();
        const content = items.length * step - GAP;
        const over = content - strip.clientWidth;
        const last = Math.min(Math.ceil(over / step), items.length - 1);
        strip.style.setProperty('--tail', over > 0 ? `${Math.max(0, last * step - over)}px` : '0px');
        if (nav) nav.hidden = over <= 0;
      } else if (nav) {
        nav.hidden = false;
      }
      sync();
    };

    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        strip.scrollBy({ left: Number(btn.dataset.dir) * stepPx(), behavior: calm.matches ? 'auto' : 'smooth' });
        // Browsers without scrollend still settle the arrows.
        setTimeout(sync, 650);
      }),
    );
    // Mouse drag (touch scrolls natively). The strip follows the pointer 1:1
    // from where it was grabbed and resists past either end; on release it
    // projects where the flick was heading and a critically damped spring
    // carries it, at the release velocity, to the nearest shot to that point.
    // Snapping is switched off while dragging and settling, then restored.
    const maxScroll = () => strip.scrollWidth - strip.clientWidth;
    const snapFor = (el: HTMLElement) => {
      const sr = strip.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      // Rects include the rubber-band stretch, which is not part of the layout.
      const tx = shots ? new DOMMatrix(getComputedStyle(shots).transform).m41 : 0;
      const x = r.left - sr.left + strip.scrollLeft - tx;
      if (getComputedStyle(el).scrollSnapAlign.startsWith('center')) return x + r.width / 2 - strip.clientWidth / 2;
      return x - (parseFloat(getComputedStyle(strip).scrollPaddingLeft) || 0);
    };
    const shots = strip.querySelector<HTMLElement>('.shots');
    let raf = 0;
    const stopSpring = () => {
      cancelAnimationFrame(raf);
      strip.classList.remove('settling');
    };
    const springTo = (target: number, velocity: number) => {
      stopSpring();
      if (calm.matches) {
        strip.scrollLeft = target;
        sync();
        return;
      }
      strip.classList.add('settling');
      const w = (2 * Math.PI) / 0.35; // response 0.35s, damping 1
      const a = strip.scrollLeft - target;
      const b = velocity + w * a;
      const t0 = performance.now();
      const step = (now: number) => {
        const t = (now - t0) / 1000;
        const e = Math.exp(-w * t);
        const x = target + (a + b * t) * e;
        const v = (b - w * (a + b * t)) * e;
        if (t > 1.2 || (Math.abs(x - target) < 0.5 && Math.abs(v) < 5)) {
          strip.scrollLeft = target;
          strip.classList.remove('settling');
          sync();
          return;
        }
        strip.scrollLeft = x;
        raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    type Grab = { id: number; x0: number; s0: number; drag: boolean; trail: { x: number; t: number }[]; over: number };
    let grab: Grab | null = null;
    let swallow = false;
    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0 || grab) return;
      stopSpring();
      grab = { id: e.pointerId, x0: e.clientX, s0: strip.scrollLeft, drag: false, trail: [{ x: e.clientX, t: e.timeStamp }], over: 0 };
    });
    strip.addEventListener('pointermove', (e) => {
      if (!grab || e.pointerId !== grab.id) return;
      const dx = e.clientX - grab.x0;
      if (!grab.drag) {
        if (Math.abs(dx) < 10) return;
        grab.drag = true;
        strip.setPointerCapture(e.pointerId);
        strip.classList.add('dragging');
      }
      const want = grab.s0 - dx;
      const max = maxScroll();
      const clamped = Math.max(0, Math.min(max, want));
      strip.scrollLeft = clamped;
      // Past either end the content stretches with resistance.
      grab.over = want - clamped;
      if (shots) shots.style.transform = grab.over ? `translateX(${-rubberband(grab.over, strip.clientWidth)}px)` : '';
      grab.trail.push({ x: e.clientX, t: e.timeStamp });
      while (grab.trail.length > 2 && e.timeStamp - grab.trail[0].t > 100) grab.trail.shift();
    });
    const release = (e: PointerEvent) => {
      if (!grab || e.pointerId !== grab.id) return;
      const { drag, trail, over } = grab;
      grab = null;
      if (!drag) return;
      swallow = true;
      setTimeout(() => (swallow = false), 0);
      strip.classList.remove('dragging');
      if (shots && over) {
        // Let the stretched content spring home.
        shots.style.transition = 'transform 450ms var(--spring)';
        shots.style.transform = '';
        setTimeout(() => (shots.style.transition = ''), 480);
      }
      const a = trail[0];
      const b = trail[trail.length - 1];
      // Scroll velocity is the opposite of the pointer's.
      const v = e.type === 'pointercancel' || b.t <= a.t ? 0 : -((b.x - a.x) / (b.t - a.t)) * 1000;
      const landing = Math.max(0, Math.min(maxScroll(), strip.scrollLeft + project(v)));
      let best = strip.scrollLeft;
      let bestD = Infinity;
      for (const el of items) {
        const snap = Math.max(0, Math.min(maxScroll(), snapFor(el)));
        const d = Math.abs(snap - landing);
        if (d < bestD) {
          bestD = d;
          best = snap;
        }
      }
      springTo(best, v);
    };
    strip.addEventListener('pointerup', release);
    strip.addEventListener('pointercancel', release);
    // A drag must not also follow the link or open the image under the pointer.
    strip.addEventListener('click', (e) => {
      if (swallow) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);
    strip.addEventListener('dragstart', (e) => e.preventDefault());
    // Anything else that moves the strip takes over from a running spring.
    strip.addEventListener('wheel', stopSpring, { passive: true });
    strip.addEventListener('touchstart', stopSpring, { passive: true });
    strip.addEventListener('scrollend', sync);
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(sync, { root: strip, threshold: [0, 1] });
      items.forEach((el) => io.observe(el));
    }
    if ('ResizeObserver' in window) new ResizeObserver(layout).observe(block);
    wide.addEventListener('change', layout);
    layout();
  });
</script>

<style>
  .block {
    display: grid;
    position: relative;
    overflow: hidden;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-2);
    background: var(--stage);
    color: #f3f4f2;
    --c-focus: #f3f4f2;
    --h: 380px;
    --ink-soft: color-mix(in oklab, #f3f4f2 62%, var(--stage));
    --mark-shadow: none;
  }
  .copy {
    /* A size container, so the title below can fit the column it is in. */
    container-type: inline-size;
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: clamp(var(--space-6), 5vw, var(--space-9)) clamp(var(--space-5), 5vw, var(--space-9)) var(--space-4);
  }
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .mk {
    --mark: 52px;
    flex: none;
  }
  .title {
    /* Never wider than the column: the head holds a 52px mark and a 16px gap
       beside the title, and the longest title here sets about 3.94em wide, so
       a long name shrinks to fit instead of running into the screenshots. */
    font-size: min(var(--step-5), calc((100cqw - 68px) / 4.1));
    line-height: 0.88;
    color: #f3f4f2;
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .sum {
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    color: var(--ink-soft);
    font-family: var(--font-data);
    font-size: var(--step--1);
    letter-spacing: var(--track-small);
  }
  .status .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .meta {
    max-width: 44ch;
    color: var(--ink-soft);
    font-family: var(--font-data);
    font-size: var(--step--1);
    line-height: 1.6;
    letter-spacing: var(--track-small);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-3);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  /* Arrows: for a mouse. A finger swipes the strip, so they are hidden on touch. */
  .nav {
    display: none;
    gap: var(--space-2);
  }
  .step {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid color-mix(in oklab, #f3f4f2 28%, var(--stage));
    border-radius: 50%;
    background: transparent;
    color: #f3f4f2;
    cursor: pointer;
    position: relative;
    transition: opacity var(--dur-fast) var(--ease-enter);
  }
  .step:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .step:not(:disabled):active {
    opacity: 0.7;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav {
      display: inline-flex;
    }
    /* The accent ring fades in over the border (opacity, not a border-colour
       change, which would repaint). */
    .step::after {
      content: '';
      position: absolute;
      inset: -1px;
      border: 1px solid var(--accent);
      border-radius: 50%;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur-fast) var(--ease-enter);
    }
    .step:not(:disabled):hover::after {
      opacity: 1;
    }
  }

  /* The strip: every screenshot in one snapped row. The scrollbar is hidden;
     the next shot peeking in at the edge says there is more, and the arrows
     and keyboard (focus the strip, then the arrow keys) work as well. */
  .strip {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    --pad: clamp(var(--space-5), 5vw, var(--space-9));
    padding-inline-start: var(--pad);
    scroll-padding-inline-start: var(--pad);
    /* So a wide shot can size itself to the strip (cqw below). */
    container-type: inline-size;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  /* Fine pointers can grab the strip and drag it. Snap is off while dragging
     and while the spring settles (it would fight every scrollLeft write). */
  @media (hover: hover) and (pointer: fine) {
    .strip {
      cursor: grab;
    }
    .strip.dragging {
      cursor: grabbing;
    }
    .strip :global(img) {
      -webkit-user-drag: none;
      user-select: none;
    }
  }
  .strip.dragging,
  .strip.settling {
    scroll-snap-type: none;
  }
  .strip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }
  .shots {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    list-style: none;
    width: max-content;
    padding-block: var(--space-4) var(--space-7);
    /* Room after the last shot so it can scroll fully into the stage. */
    padding-inline-end: clamp(var(--space-5), 5vw, var(--space-9));
  }
  .shot {
    display: grid;
    gap: var(--space-3);
    scroll-snap-align: start;
    flex: none;
  }
  .frame {
    padding: 6px;
    border-radius: var(--radius-3);
    background: #0b0a09;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .frame :global(img) {
    display: block;
    height: var(--h);
    width: auto;
    border-radius: calc(var(--radius-3) - 6px);
    background: #0f1117;
  }
  .wide .frame {
    padding: 4px;
    border-radius: var(--radius-2);
  }
  /* A landscape shot fits the strip with a sliver of the next one showing
     (frame + 20px gap + ~20px peek), never running off the edge. */
  .wide .frame :global(img) {
    width: min(calc(100cqw - 48px), 560px);
    height: auto;
    border-radius: calc(var(--radius-2) - 3px);
  }
  /* Phones: each shot snaps to the centre, and the first and last get enough
     lead-in and tail to centre too, so the frame sits mid-stage with a sliver of
     its neighbour either side. --fw is the frame's own width. */
  @media (max-width: 899px) {
    .strip {
      padding-inline: 0;
      scroll-padding-inline: 0;
    }
    .shots {
      padding-inline-end: 0;
    }
    .shot {
      scroll-snap-align: center;
      --fw: calc(var(--h) * var(--ar) + 12px);
    }
    .shot.wide {
      --fw: calc(100cqw - 80px);
    }
    .wide .frame :global(img) {
      width: calc(100cqw - 88px);
    }
    .shot:first-child {
      margin-inline-start: calc((100cqw - var(--fw)) / 2);
    }
    .shot:last-child {
      margin-inline-end: calc((100cqw - var(--fw)) / 2);
    }
  }
  .cap {
    padding-inline: 6px;
    color: var(--ink-soft);
    font-family: var(--font-data);
    font-size: var(--step--1);
    letter-spacing: var(--track-small);
  }
  @media (min-width: 900px) {
    .block {
      grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
      align-items: center;
      --h: 460px;
    }
    .copy {
      padding-bottom: clamp(var(--space-6), 5vw, var(--space-9));
      padding-inline-end: var(--space-5);
    }
    /* Desktop: starts just after the text column and runs off the stage's right
       edge, the cropped last shot saying there is more. The gap after the text
       is a margin, not padding, so the strip's left edge is where a phone
       starts: a scrolled-past phone is fully out of the window, never a sliver.
       The 2px of padding only keeps the first frame's 1px ring from clipping. */
    .strip {
      margin-inline-start: var(--space-7);
      padding-inline-start: 2px;
      scroll-padding-inline-start: 2px;
    }
    .shots {
      padding-block: var(--space-7);
      padding-inline-end: var(--space-9);
    }
    /* A landscape shot is 620px, but never wider than the window (the strip is a
       size container), so even a narrow desktop shows it whole. 12px is the
       frame's padding plus the strip's 2px inset. */
    .wide .frame :global(img) {
      width: min(620px, calc(100cqw - 12px));
    }

    /* Desktop end of strip (--tail is set by the script): empty space after
       the last shot, just enough that the strip's last scroll position starts
       on a phone, so the left edge never cuts one. */
    .shots {
      padding-inline-end: var(--tail, var(--space-9));
    }

  }
</style>
