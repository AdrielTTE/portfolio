---
// One project on the home page's Work section: a stage in the project's own
// colour, its name and summary, one clear way into the case study, and every
// screenshot in a strip you scroll through (swipe, trackpad, keyboard, or the
// arrows on a mouse). Each shot keeps its own shape: portrait screens in a
// device frame, landscape ones in a wide frame.
// Borrowed: the screens-on-a-colour-stage case-study cards of product studios,
// with a snapped horizontal strip instead of a hover preview, since hover does
// not exist on a phone.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ProjectMark from './ProjectMark.astro';
import type { WorkEntry } from '../lib/work';

interface Props { project: WorkEntry }
const { project } = Astro.props;
const { title, summary, scope, year, stack, stage, accent, shots, icon, mark, status } = project.data;
const vars = `--stage:${stage ?? '#14161f'};--accent:${accent ?? '#f3f4f2'}`;
const href = `/work/${project.id}/`;
---
<article class="block" style={vars} data-block>
  <div class="copy">
    <div class="head">
      {(icon || mark) && <div class="mk"><ProjectMark kind={mark} icon={icon} /></div>}
      <h3 class="title display"><a href={href}>{title}</a></h3>
    </div>
    <p class="sum">{summary}</p>
    {status && <p class="status"><span class="dot" aria-hidden="true"></span>{status}</p>}
    <p class="meta">{scope}, {year}. {stack.join(', ')}.</p>
    <p class="actions">
      <a class="cta" href={href}>View the case study <span class="arrow" aria-hidden="true"><Icon name="arrow-right" /></span></a>
      {shots.length > 1 && (
        <span class="nav" data-nav>
          <span class="pager" data-pager aria-live="polite"></span>
          <button type="button" class="step" data-dir="-1" aria-label={`Previous ${title} screenshot`} disabled><Icon name="arrow-left" /></button>
          <button type="button" class="step" data-dir="1" aria-label={`Next ${title} screenshot`}><Icon name="arrow-right" /></button>
        </span>
      )}
    </p>
  </div>
  {shots.length > 0 && (
    <div class="strip" role="region" aria-label={`${title} screenshots`} tabindex="0" data-strip>
      <ul class="shots">
        {shots.map((s) => {
          const wide = s.src.width > s.src.height;
          return (
            <li class:list={['shot', { wide }]} style={`--ar:${s.src.width / s.src.height}`}>
              <div class="frame">
                <Image
                  src={s.src}
                  alt={s.alt}
                  widths={wide ? [480, 720, 960] : [240, 360, 480]}
                  sizes={wide ? '(min-width: 900px) 620px, 86vw' : '(min-width: 900px) 220px, 190px'}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              {s.label && <span class="cap">{s.label}</span>}
            </li>
          );
        })}
      </ul>
    </div>
  )}
</article>

<script>
  // Phones and tablets: the arrows (mouse only) scroll the strip by one shot and
  // swipe works natively. Desktop (900px and up): the strip becomes a window
  // sized to a whole number of shots, so nothing is ever cropped, and the arrows
  // move a page at a time with a "1 / 2" counter. If every shot fits, the arrows
  // and counter are hidden. There is no per-frame scroll listener:
  // IntersectionObserver notices shots entering and leaving, scrollend settles
  // the counter, and ResizeObserver handles resizing.
  document.querySelectorAll<HTMLElement>('[data-block]').forEach((block) => {
    if (block.dataset.bound) return;
    block.dataset.bound = '1';
    const strip = block.querySelector<HTMLElement>('[data-strip]');
    const nav = block.querySelector<HTMLElement>('[data-nav]');
    const pager = block.querySelector<HTMLElement>('[data-pager]');
    const buttons = [...block.querySelectorAll<HTMLButtonElement>('button[data-dir]')];
    if (!strip || buttons.length === 0) return;
    const [prev, next] = buttons;
    const items = [...strip.querySelectorAll<HTMLElement>('.shot')];
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const wide = matchMedia('(min-width: 900px)');
    const GAP = 20;
    let k = 1;
    let pages = 1;

    const stepPx = () => (items[0]?.offsetWidth ?? 240) + GAP;
    const behavior = () => (calm.matches ? 'auto' : 'smooth');
    const maxLeft = () => strip.scrollWidth - strip.clientWidth;
    const pageLeft = (p: number) => Math.min(p * k * stepPx(), maxLeft());
    const currentPage = () => {
      if (strip.scrollLeft >= maxLeft() - 4) return pages - 1;
      return Math.min(pages - 1, Math.floor((strip.scrollLeft + stepPx() / 2) / (k * stepPx())));
    };

    const sync = () => {
      prev.disabled = strip.scrollLeft < 4;
      next.disabled = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4;
      if (pager) pager.textContent = block.classList.contains('paged') ? `${currentPage() + 1} / ${pages}` : '';
    };

    const layout = () => {
      // Keep the page the reader is on, and keep the snap points in place while
      // measuring: with none, the browser would snap to the last shot.
      const keep = block.classList.contains('paged') ? currentPage() : 0;
      strip.style.removeProperty('--win');
      if (!wide.matches || items.length === 0) {
        items.forEach((el) => delete el.dataset.snap);
        block.classList.remove('paged');
        if (nav) nav.hidden = false;
        sync();
        return;
      }
      block.classList.add('paged');
      const avail = strip.clientWidth;
      const w = items[0].offsetWidth;
      k = Math.max(1, Math.min(items.length, Math.floor((avail + GAP) / (w + GAP))));
      pages = Math.ceil(items.length / k);
      strip.style.setProperty('--win', `${k * w + (k - 1) * GAP}px`);
      items.forEach((el, i) => {
        if (i % k === 0) el.dataset.snap = '';
        else delete el.dataset.snap;
      });
      if (nav) nav.hidden = pages < 2;
      strip.scrollLeft = pageLeft(Math.min(keep, pages - 1));
      sync();
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const dir = Number(b.dataset.dir);
        if (block.classList.contains('paged')) {
          const to = Math.max(0, Math.min(pages - 1, currentPage() + dir));
          strip.scrollTo({ left: pageLeft(to), behavior: behavior() });
        } else {
          strip.scrollBy({ left: dir * stepPx(), behavior: behavior() });
        }
        // Browsers without scrollend still settle the counter and arrows.
        setTimeout(sync, 650);
      }),
    );
    // The observer only fires as shots cross the edges, which is before a smooth
    // scroll lands; scrollend (one event per scroll, not per frame) finishes it.
    strip.addEventListener('scrollend', sync);

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(sync, { root: strip, threshold: [0, 1] });
      items.forEach((el) => io.observe(el));
    }
    if ('ResizeObserver' in window) new ResizeObserver(layout).observe(block);
    wide.addEventListener('change', layout);
    layout();
  });
</script>

<style>
  .block {
    display: grid;
    position: relative;
    overflow: hidden;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-2);
    background: var(--stage);
    color: #f3f4f2;
    --c-focus: #f3f4f2;
    --h: 380px;
    --ink-soft: color-mix(in oklab, #f3f4f2 62%, var(--stage));
    --mark-shadow: none;
  }
  .copy {
    /* A size container, so the title below can fit the column it is in. */
    container-type: inline-size;
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: clamp(var(--space-6), 5vw, var(--space-9)) clamp(var(--space-5), 5vw, var(--space-9)) var(--space-4);
  }
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .mk {
    --mark: 52px;
    flex: none;
  }
  .title {
    /* Never wider than the column: the head holds a 52px mark and a 16px gap
       beside the title, and the longest title here sets about 3.94em wide, so
       a long name shrinks to fit instead of running into the screenshots. */
    font-size: min(var(--step-5), calc((100cqw - 68px) / 4.1));
    line-height: 0.88;
    color: #f3f4f2;
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .sum {
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    width: fit-content;
    color: var(--ink-soft);
    font-family: var(--font-data);
    font-size: var(--step--1);
    letter-spacing: -0.01em;
  }
  .status .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .meta {
    max-width: 44ch;
    color: var(--ink-soft);
    font-family: var(--font-data);
    font-size: var(--step--1);
    line-height: 1.6;
    letter-spacing: -0.01em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-3);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  /* Arrows: for a mouse. A finger swipes the strip, so they are hidden on touch. */
  .nav {
    display: none;
    gap: var(--space-2);
  }
  .step {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid color-mix(in oklab, #f3f4f2 28%, var(--stage));
    border-radius: 50%;
    background: transparent;
    color: #f3f4f2;
    cursor: pointer;
    transition:
      opacity var(--dur-fast) var(--ease-enter),
      border-color var(--dur-fast) var(--ease-enter);
  }
  .step:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .pager {
    align-self: center;
    margin-inline-end: var(--space-2);
    color: var(--ink-soft);
    font-family: var(--font-data);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }
  .pager:empty {
    display: none;
  }
  .step:not(:disabled):active {
    opacity: 0.7;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav {
      display: inline-flex;
    }
    .step:not(:disabled):hover {
      border-color: var(--accent);
    }
  }

  /* The strip: every screenshot in one snapped row. The scrollbar is hidden;
     the next shot peeking in at the edge says there is more, and the arrows
     and keyboard (focus the strip, then the arrow keys) work as well. */
  .strip {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    --pad: clamp(var(--space-5), 5vw, var(--space-9));
    padding-inline-start: var(--pad);
    scroll-padding-inline-start: var(--pad);
    /* So a wide shot can size itself to the strip (cqw below). */
    container-type: inline-size;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  .strip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }
  .shots {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    list-style: none;
    width: max-content;
    padding-block: var(--space-4) var(--space-7);
    /* Room after the last shot so it can scroll fully into the stage. */
    padding-inline-end: clamp(var(--space-5), 5vw, var(--space-9));
  }
  .shot {
    display: grid;
    gap: var(--space-3);
    scroll-snap-align: start;
    flex: none;
  }
  .frame {
    padding: 6px;
    border-radius: var(--radius-3);
    background: #0b0a09;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .frame :global(img) {
    display: block;
    height: var(--h);
    width: auto;
    border-radius: calc(var(--radius-3) - 6px);
    background: #0f1117;
  }
  .wide .frame {
    padding: 4px;
    border-radius: var(--radius-2);
  }
  /* A landscape shot fits the strip with a sliver of the next one showing
     (frame + 20px gap + ~20px peek), never running off the edge. */
  .wide .frame :global(img) {
    width: min(calc(100cqw - 48px), 560px);
    height: auto;
    border-radius: calc(var(--radius-2) - 3px);
  }
  /* Phones: each shot snaps to the centre, and the first and last get enough
     lead-in and tail to centre too, so the frame sits mid-stage with a sliver of
     its neighbour either side. --fw is the frame's own width. */
  @media (max-width: 899px) {
    .strip {
      padding-inline: 0;
      scroll-padding-inline: 0;
    }
    .shots {
      padding-inline-end: 0;
    }
    .shot {
      scroll-snap-align: center;
      --fw: calc(var(--h) * var(--ar) + 12px);
    }
    .shot.wide {
      --fw: calc(100cqw - 80px);
    }
    .wide .frame :global(img) {
      width: calc(100cqw - 88px);
    }
    .shot:first-child {
      margin-inline-start: calc((100cqw - var(--fw)) / 2);
    }
    .shot:last-child {
      margin-inline-end: calc((100cqw - var(--fw)) / 2);
    }
  }
  .cap {
    padding-inline: 6px;
    color: var(--ink-soft);
    font-family: var(--font-data);
    font-size: var(--step--1);
    letter-spacing: -0.01em;
  }
  @media (min-width: 900px) {
    .block {
      grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
      align-items: center;
      --h: 460px;
    }
    .copy {
      padding-bottom: clamp(var(--space-6), 5vw, var(--space-9));
      padding-inline-end: var(--space-5);
    }
    /* Desktop: starts just after the text column and runs off the stage's right
       edge, the cropped last shot saying there is more. */
    .strip {
      padding-inline-start: var(--space-7);
      scroll-padding-inline-start: var(--space-7);
    }
    .shots {
      padding-block: var(--space-7);
      padding-inline-end: var(--space-9);
    }
    .wide .frame :global(img) {
      width: 620px;
    }

    /* Paged (set by the script): the strip is a window exactly as wide as a
       whole number of shots (--win), so no shot is ever cut by an edge. It
       still scrolls natively and snaps to pages, so a trackpad or a touch
       screen at this width works without the arrows. */
    .paged .strip {
      width: var(--win, auto);
      margin-inline: var(--space-7) var(--space-8);
      padding-inline: 0;
      scroll-padding-inline: 0;
    }
    .paged .shots {
      padding-inline-end: 0;
    }
    .paged .shot {
      scroll-snap-align: none;
    }
    .paged .shot[data-snap],
    .paged .shot:last-child {
      scroll-snap-align: start;
    }
    .paged .shot:last-child:not([data-snap]) {
      scroll-snap-align: end;
    }
  }
</style>
