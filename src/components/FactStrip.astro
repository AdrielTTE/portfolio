---
// Verified figures for a case study, set large in the display voice (same
// look as BuildReceipts). Values come from the project's front matter.
interface Props { facts: { value: string; label: string }[] }
const { facts } = Astro.props;
---
<dl>
  {facts.map((f) => (
    <div>
      <dt>{f.label}</dt>
      <dd class="display">{f.value}</dd>
    </div>
  ))}
</dl>

<style>
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-5) var(--gutter);
  }
  /* Each fact is as tall as the tallest in its row, with the figure pinned to
     the bottom: a label that wraps onto a second line no longer pushes its
     number below its neighbours'. */
  dl > div {
    display: flex;
    flex-direction: column;
  }
  dt {
    color: var(--c-ink-2);
  }
  dd {
    margin-top: auto;
    padding-top: var(--space-1);
    font-size: var(--step-6);
    color: var(--c-display);
    font-variant-numeric: tabular-nums;
  }
</style>
