---
// Sticky site header: name, primary nav, theme toggle, and the scroll
// progress rule as its bottom edge. docs/design-spec.md §5.0.
import ThemeToggle from './ThemeToggle.astro';
import ProgressBar from './ProgressBar.astro';

interface Props {
  current?: 'work' | 'about' | 'contact';
}
const { current } = Astro.props;
---
<header class="site-header" style="view-transition-name: site-header">
  <div class="container bar">
    <a href="/" class="name">Adriel Tang</a>
    <nav aria-label="Main" class="nav">
      <a href="/#work" class="nav-link" aria-current={current === 'work' ? 'page' : undefined}>Work</a>
      <a href="/about" class="nav-link" aria-current={current === 'about' ? 'page' : undefined}>About</a>
      <a href="/contact" class="nav-link" aria-current={current === 'contact' ? 'page' : undefined}>Contact</a>
      <ThemeToggle />
      <a href="#site-footer" class="menu" data-palette-open aria-haspopup="dialog">
        Menu <kbd class="menu-hint" data-kbd-mod aria-hidden="true">⌘K</kbd>
      </a>
    </nav>
  </div>
  <ProgressBar />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--c-bg);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .name {
    font-weight: 500;
    font-size: var(--step-0);
    text-decoration: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  @media (min-width: 600px) {
    .nav {
      gap: 24px;
    }
  }
  .nav-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-block: 12px;
    font-weight: 500;
    font-size: var(--step-0);
    text-decoration: none;
    position: relative;
  }
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    height: 1px;
    background: var(--c-ink);
  }
  .menu {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding-inline: 12px;
    border: 1px solid var(--c-rule);
    border-radius: 4px;
    font-weight: 500;
    font-size: var(--step-0);
    text-decoration: none;
    color: var(--c-ink);
  }
  .menu-hint {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
  @media (pointer: coarse) {
    .menu {
      min-height: 44px;
    }
    .menu-hint {
      display: none;
    }
  }
  @media (max-width: 599px) {
    .nav-link {
      display: none;
    }
  }
</style>
