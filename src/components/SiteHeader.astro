---
// Sticky site header: name, primary nav, theme toggle, and the scroll
// progress rule as its bottom edge. Plain words, no boxed controls: the
// header is a masthead line, not a toolbar.
import ThemeToggle from './ThemeToggle.astro';
import ProgressBar from './ProgressBar.astro';

interface Props {
  current?: 'work' | 'about' | 'contact';
}
const { current } = Astro.props;
// On a case study, Work is the section you're in (aria-current="true"), not
// the page itself.
const workCurrent = current === 'work' ? (Astro.url.pathname.startsWith('/work/') ? 'true' : 'page') : undefined;
---
<header class="site-header" style="view-transition-name: site-header">
  <div class="container bar">
    <a href="/" class="name" aria-label="Adriel Tang, home">Adriel Tang</a>
    <nav aria-label="Main" class="nav">
      <a href="/#work" class="nav-link nav-link--wide" aria-current={workCurrent}>Work</a>
      <a href="/about/" class="nav-link nav-link--wide" aria-current={current === 'about' ? 'page' : undefined}>About</a>
      <a href="/contact/" class="nav-link" aria-current={current === 'contact' ? 'page' : undefined}>Contact</a>
      <ThemeToggle />
      <a href="#site-footer" class="menu" data-palette-open aria-haspopup="dialog">
        Menu <kbd class="menu-hint" data-kbd-mod aria-hidden="true">⌘K</kbd>
      </a>
    </nav>
  </div>
  <ProgressBar />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--c-bg);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: var(--step-1);
    font-stretch: var(--display-stretch);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 4px 24px;
  }
  .nav-link,
  .menu {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 500;
    font-size: var(--step-0);
    text-decoration: none;
    color: var(--c-ink);
  }
  /* The nav underline slides in from the left (transform only). */
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease-enter);
  }
  .nav-link[aria-current]::after {
    transform: scaleX(1);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover::after {
      transform: scaleX(1);
    }
    .menu:hover,
    .name:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
  }
  .menu-hint {
    font-family: inherit;
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
  @media (pointer: coarse) {
    .menu-hint {
      display: none;
    }
  }
  /* Phones: the palette is the nav, but Contact stays in view as the one
     direct route. */
  @media (max-width: 599px) {
    .nav {
      gap: 14px;
    }
    .menu-hint,
    .nav-link--wide {
      display: none;
    }
  }
</style>
