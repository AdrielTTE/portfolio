---
// Work index: every project as one typographic entry, newest first. The
// title is set big in the condensed display voice; the one-line summary and a
// plain "scope, stack" line sit beside it. No thumbnails and no chips: two of
// the three projects have no screenshots, so the entries are type-led for all
// of them rather than framing empty devices.
// Borrowed: the title/subline index from frankchimero.com, scaled up to the
// big condensed titles of henry.codes.
import ProjectMark from './ProjectMark.astro';
import type { WorkEntry } from '../lib/work';

interface Props { projects: WorkEntry[] }
const { projects } = Astro.props;
const rows = [...projects].sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);
---
<section class="work" aria-labelledby="work-h" id="work">
  <h2 id="work-h" class="display section-h">Work</h2>
  <ol class="rows">
    {rows.map((p) => (
      <li class="work-row">
        <a href={`/work/${p.id}/`}>
          <span class="title display"><span class="tw">{p.data.title.split(' ').map((w, i) => (<><span class="tx"><span class="tx-in" style={`--w:${i}`}>{w}</span></span>{' '}</>))}</span><span class="go arrow" aria-hidden="true">→</span><span class="mk"><ProjectMark kind={p.data.mark} /></span></span>
          <span class="about">
            <span class="ln line"><span class="ln-in" style="--l:0">{p.data.summary}</span></span>
            <span class="ln meta"><span class="ln-in" style="--l:1">{p.data.scope}, {p.data.year}. {p.data.stack.join(', ')}.</span></span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>

<script>
  // One-time per-row reveal; never re-animates.
  const rows = document.querySelectorAll<HTMLElement>('.js-reveal .work-row');
  if (rows.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0 },
    );
    rows.forEach((r) => io.observe(r));
  } else rows.forEach((r) => r.classList.add('in'));
</script>

<style>
  .section-h {
    font-size: var(--step-4);
    color: var(--c-ink);
    margin-bottom: var(--space-6);
  }
  .rows {
    list-style: none;
    border-top: 1px solid var(--c-ink);
  }
  .work-row {
    border-bottom: 1px solid var(--c-rule);
  }
  .work-row a {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-7);
    color: inherit;
    text-decoration: none;
  }
  .title {
    font-size: var(--step-6);
    color: var(--c-display);
    display: flex;
    align-items: baseline;
    gap: 0.25em;
    padding-bottom: 0.06em;
  }
  .mk {
    margin-left: auto;
    align-self: center;
    --mark: 48px;
  }
  @media (min-width: 1024px) {
    .mk {
      --mark: 88px;
    }
  }
  .go {
    font-size: 0.5em;
    font-stretch: 100%;
    font-weight: 400;
  }
  .about {
    display: grid;
    gap: var(--space-2);
    max-width: 46ch;
  }
  .line {
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .meta {
    color: var(--c-ink-2);
  }
  .work-row a:focus-visible {
    outline-offset: 4px;
  }

  @media (min-width: 1024px) {
    .work-row a {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: var(--gutter);
      align-items: end;
      padding-block: var(--space-7);
    }
    .about {
      padding-bottom: 0.6em;
    }
  }

  /* Reveal, once per row as it enters view (script above adds .in): the
     title rises out of its own mask, the row rule draws left to right, the
     summary lands just after. Transform and opacity only. Hidden only under
     .js-reveal, so no-JS and reduced motion show everything. */
  .tw {
    display: block;
  }
  .tx,
  .ln {
    display: inline-block;
    vertical-align: bottom;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .ln {
    display: block;
  }
  .tx-in,
  .ln-in {
    display: block;
  }
  .work-row {
    position: relative;
  }
  .work-row::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px 0;
    height: 3px;
    background: var(--c-ink);
    transform-origin: left;
  }
  .mk {
    transform-origin: center;
  }
  :global(.js-reveal) .work-row:not(.in) .tx-in {
    transform: translateY(115%) rotate(4deg);
  }
  :global(.js-reveal) .work-row:not(.in) .ln-in {
    transform: translateY(120%);
  }
  :global(.js-reveal) .work-row:not(.in)::after {
    transform: scaleX(0);
  }
  :global(.js-reveal) .work-row:not(.in) .mk {
    transform: scale(0.4) rotate(-25deg);
  }
  :global(.js-reveal) .work-row .tx-in {
    transform-origin: left bottom;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--w, 0) * 90ms + 150ms);
  }
  :global(.js-reveal) .work-row .ln-in {
    transition: transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--l, 0) * 110ms + 450ms);
  }
  :global(.js-reveal) .work-row .mk {
    transition: transform 900ms cubic-bezier(0.34, 1.4, 0.5, 1) 500ms;
  }
  :global(.js-reveal) .work-row::after {
    transition: transform 1100ms cubic-bezier(0.65, 0, 0.2, 1);
  }

  /* Fine pointers: the title slides in and the arrow arrives. Touch keeps
     the arrow visible at rest, so the row still reads as a link. */
  @media (hover: hover) and (pointer: fine) {
    .title,
    .go {
      transition:
        transform var(--dur-base) var(--ease-enter),
        opacity var(--dur-base) var(--ease-enter);
    }
    .go {
      opacity: 0;
      transform: translateX(-0.3em);
    }
    .work-row a:hover .title {
      transform: translateX(12px);
    }
    .work-row {
      transition: opacity var(--dur-base) var(--ease-enter);
    }
    .rows:has(a:hover) .work-row:not(:hover),
    .rows:has(a:focus-visible) .work-row:not(:has(a:focus-visible)) {
      opacity: 0.4;
    }
    .work-row a:hover .go {
      opacity: 1;
      transform: none;
    }
  }
</style>
