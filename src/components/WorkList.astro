---
// Work index: every project as one bold, scannable row (name, one line, stack,
// year), newest first. No lead slot: a big empty frame for a project with no
// screenshot read as a placeholder. Desktop fine pointers get the
// cursor-follow screenshot and the other rows dim; touch and narrow screens
// show a real screenshot inline instead. Only projects with a real screenshot
// get a thumb or a preview. Filters only at 6+ projects. Spec §3.1 item 3,
// §5.3 item 4.
import DeviceFrame from './DeviceFrame.astro';
import { scopeCounts, type WorkEntry } from '../lib/work';

interface Props { projects: WorkEntry[] }
const { projects } = Astro.props;
const rows = [...projects].sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);
const scopes = rows.length >= 6 ? scopeCounts(rows) : [];
const anyShots = rows.some((p) => p.data.shots.length > 0);
---
<section class="work" aria-labelledby="work-h" id="work">
  <div class="head">
    <h2 id="work-h">Work</h2>
    <p class="count">{rows.length} {rows.length === 1 ? 'project' : 'projects'}, newest first</p>
  </div>
  {scopes.length > 1 && (
    <div class="filters" role="group" aria-label="Filter by scope">
      <button type="button" aria-pressed="true" data-filter="*">All</button>
      {scopes.map((s) => <button type="button" aria-pressed="false" data-filter={s.scope}>{s.scope} <span class="n">{s.n}</span></button>)}
    </div>
  )}
  <ol id="work-list" class={`rows${anyShots ? ' rows--thumbs' : ''}`}>
    {rows.map((p) => (
      <li class={`work-row${p.data.shots.length > 0 ? ' has-thumb' : ''}`} data-scope={p.data.scope} data-slug={p.id}>
        <a href={`/work/${p.id}/`}>
          {p.data.shots.length > 0 && <div class="thumb"><DeviceFrame project={p} variant="thumb" /></div>}
          <span class="title"><span class="name">{p.data.title}</span><span class="go arrow" aria-hidden="true">→</span></span>
          <span class="line">{p.data.summary}</span>
          <span class="chips"><span class="scope">{p.data.scope}</span>{p.data.stack.map((s) => <span class="chip">{s}</span>)}</span>
          <span class="year">{p.data.year}</span>
        </a>
      </li>
    ))}
  </ol>
  <div class="preview" aria-hidden="true" hidden></div>
</section>

<script src="../scripts/shot-preview.ts"></script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    margin-bottom: var(--space-5);
  }
  .head h2 {
    font-size: var(--step-1);
    font-weight: 600;
  }
  .count {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
  .rows { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--c-ink); }

  /* Phones and tablets: name + year on one line, then the line and chips,
     then (if there is one) the screenshot at a readable size. */
  .work-row a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 16px;
    row-gap: 8px;
    padding-block: 20px 24px;
    border-bottom: 1px solid var(--c-rule);
    color: inherit;
    text-decoration: none;
  }
  .title { grid-area: 1 / 1; display: flex; align-items: baseline; gap: 16px; }
  .name {
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .year { grid-area: 1 / 2; align-self: start; padding-top: 0.4em; }
  .go { display: none; }
  .line { grid-column: 1 / -1; color: var(--c-ink-2); max-width: 52ch; }
  .chips { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px; }
  .thumb { grid-column: 1 / -1; grid-row: 4; margin-top: 8px; max-width: 520px; }
  .chip, .scope, .year { font-family: var(--font-mono); font-size: var(--step--1); color: var(--c-ink-2); font-variant-numeric: tabular-nums; }
  .chip { border: 1px solid var(--c-rule); border-radius: 4px; padding: 1px 6px; }
  .scope { padding: 2px 8px 2px 0; color: var(--c-ink); }
  .work-row a:active .name { color: var(--c-accent); }
  .work-row a:focus-visible { outline: 2px solid var(--c-focus); outline-offset: 2px; }

  /* Wide: a four-column index with the name set big on the left. */
  @media (min-width: 1024px) {
    .work-row a {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr) minmax(0, 3fr) 56px;
      align-items: baseline;
      column-gap: var(--gutter);
      padding-block: 28px;
    }
    .title { grid-area: auto; }
    .name { font-size: var(--step-5); }
    .go { display: block; font-size: var(--step-3); color: var(--c-accent); opacity: 0; }
    .line, .chips { grid-column: auto; }
    .year { grid-area: auto; align-self: auto; text-align: right; padding-top: 0; }
    .thumb { grid-row: auto; grid-column: auto; margin-top: 0; }
  }
  /* Fine pointers get the cursor preview instead of a thumb. */
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .thumb { display: none; }
    .name, .go { transition: transform var(--dur-base) var(--ease-enter), opacity var(--dur-base) var(--ease-enter); }
    .go { transform: translateX(-12px); }
    .work-row a { transition: opacity var(--dur-base) var(--ease-enter); }
    .work-row a:hover .name { transform: translateX(8px); }
    .work-row a:hover .go { opacity: 1; transform: translateX(0); }
    /* Index focus: the row under the pointer stays, the rest step back. */
    .rows:has(a:hover) .work-row a:not(:hover) { opacity: 0.5; }
  }
  /* Touch at 1024+ (iPad landscape) has no hover preview, so rows keep a
     thumb in a leading column; rows without a screenshot leave it empty so
     every name still lines up. */
  @media (min-width: 1024px) and (not ((hover: hover) and (pointer: fine))) {
    .rows--thumbs .work-row a { grid-template-columns: 120px minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr) 56px; align-items: center; }
    .rows--thumbs .go { display: none; }
    .rows--thumbs .work-row:not(.has-thumb) .title { grid-column: 2; }
    .name { font-size: var(--step-4); }
  }
  /* One fixed 320x200 box (addendum §8); the cloned frame fills it and its
     screenshot covers it. */
  .preview { position: fixed; top: 0; left: 0; width: 320px; height: 200px; overflow: hidden; border-radius: 6px; pointer-events: none; z-index: 20; opacity: 0; transition: opacity var(--dur-fast) var(--ease-enter); will-change: transform; }
  .preview.on { opacity: 1; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .filters button { font: inherit; font-family: var(--font-mono); font-size: var(--step--1); padding: 4px 10px; border: 1px solid var(--c-rule); border-radius: 2px; background: none; color: var(--c-ink); min-height: 32px; }
  .filters button[aria-pressed='true'] { background: var(--c-ink); color: var(--c-bg); }
  @media (pointer: coarse) { .filters button { min-height: 44px; } }
  .preview :global(.frame) { width: 100%; height: 100%; aspect-ratio: auto; }
</style>
