---
// Work index: every project as one typographic entry, newest first. The
// title is set big in the condensed display voice; the one-line summary and a
// plain "scope, stack" line sit beside it. No thumbnails and no chips: two of
// the three projects have no screenshots, so the entries are type-led for all
// of them rather than framing empty devices.
// Borrowed: the title/subline index from frankchimero.com, scaled up to the
// big condensed titles of henry.codes.
import { Image } from 'astro:assets';
import type { WorkEntry } from '../lib/work';

interface Props { projects: WorkEntry[] }
const { projects } = Astro.props;
const rows = [...projects].sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);
---
<section class="work" aria-labelledby="work-h" id="work">
  <h2 id="work-h" class="display section-h">Work</h2>
  <ol class="rows">
    {rows.map((p) => (
      <li class="work-row">
        <a href={`/work/${p.id}/`}>
          <span class="title display">{p.data.title}<span class="go arrow" aria-hidden="true">→</span></span>
          <span class="about">
            <span class="line">{p.data.summary}</span>
            <span class="meta">{p.data.scope}, {p.data.year}. {p.data.stack.join(', ')}.</span>
          </span>
        </a>
        <div class="peek" aria-hidden="true">
          {p.data.shots[0] ? (
            <Image src={p.data.shots[0].src} alt="" width={300} class="peek-img" />
          ) : (
            <>
              <span class="peek-year">{p.data.year}</span>
              <span class="peek-scope">{p.data.scope}</span>
              <span class="peek-stack">{p.data.stack.join(' / ')}</span>
            </>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<script src="../scripts/work-peek.ts"></script>

<style>
  .section-h {
    font-size: var(--step-4);
    color: var(--c-ink);
    margin-bottom: var(--space-6);
  }
  .rows {
    list-style: none;
    border-top: 1px solid var(--c-ink);
  }
  .work-row {
    border-bottom: 1px solid var(--c-rule);
  }
  .work-row a {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-7);
    color: inherit;
    text-decoration: none;
  }
  .title {
    font-size: var(--step-6);
    color: var(--c-display);
    display: flex;
    align-items: baseline;
    gap: 0.25em;
    padding-bottom: 0.06em;
  }
  .go {
    font-size: 0.5em;
    font-stretch: 100%;
    font-weight: 400;
  }
  .about {
    display: grid;
    gap: var(--space-2);
    max-width: 46ch;
  }
  .line {
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .meta {
    color: var(--c-ink-2);
  }
  .work-row a:focus-visible {
    outline-offset: 4px;
  }

  @media (min-width: 1024px) {
    .work-row a {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: var(--gutter);
      align-items: end;
      padding-block: var(--space-7);
    }
    .about {
      padding-bottom: 0.6em;
    }
  }

  /* Pointer-following card (work-peek.ts). Hidden everywhere except fine
     pointers; JS moves it with transform, CSS fades it with opacity. */
  .peek {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .peek {
      display: grid;
      align-content: space-between;
      gap: var(--space-4);
      position: fixed;
      left: 0;
      top: 0;
      z-index: 20;
      width: 300px;
      height: 200px;
      padding: var(--space-4);
      overflow: hidden;
      background: var(--c-block);
      color: var(--c-block-ink);
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--dur-base) var(--ease-enter);
    }
    .peek.on {
      opacity: 1;
    }
    .peek-year {
      font-family: var(--font-sans);
      font-stretch: var(--display-stretch);
      font-weight: 800;
      font-size: 72px;
      line-height: 0.85;
    }
    .peek-scope {
      font-weight: 600;
    }
    .peek-stack {
      color: var(--c-block-ink-2);
      font-size: var(--step--1);
    }
    .peek :global(.peek-img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  /* Scroll-driven (where supported): each title slides in as its row enters
     the viewport. Transform and opacity only; no scroll listener. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .title {
        animation: title-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .about {
        animation: about-in linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 90%;
      }
    }
  }
  @keyframes about-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .about {
        animation: about-in linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 90%;
      }
    }
  }
  @keyframes about-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes title-in {
    from {
      opacity: 0;
      transform: translateX(-32px);
    }
  }

  /* Fine pointers: the title slides in and the arrow arrives. Touch keeps
     the arrow visible at rest, so the row still reads as a link. */
  @media (hover: hover) and (pointer: fine) {
    .title,
    .go {
      transition:
        transform var(--dur-base) var(--ease-enter),
        opacity var(--dur-base) var(--ease-enter);
    }
    .go {
      opacity: 0;
      transform: translateX(-0.3em);
    }
    .work-row a:hover .title {
      transform: translateX(12px);
    }
    .work-row {
      transition: opacity var(--dur-base) var(--ease-enter);
    }
    .rows:has(a:hover) .work-row:not(:hover),
    .rows:has(a:focus-visible) .work-row:not(:has(a:focus-visible)) {
      opacity: 0.4;
    }
    .work-row a:hover .go {
      opacity: 1;
      transform: none;
    }
  }
</style>
