---
import Icon from './Icon.astro';
// Work index: every project as one typographic entry, newest first. The
// title is set big in the condensed display voice; the one-line summary and a
// plain "scope, stack" line sit beside it. No chips; the rows stay type-led.
// On a mouse, hovering a row brings that project's first real screenshot in
// beside the cursor (a decorative extra: touch and keyboard users get the same
// information from the row and its case study).
// Borrowed: the title/subline index from frankchimero.com, scaled up to the
// big condensed titles of henry.codes; the cursor-following image preview
// from the hover lists on many studio sites.
import { Image } from 'astro:assets';
import ProjectMark from './ProjectMark.astro';
import type { WorkEntry } from '../lib/work';

interface Props { projects: WorkEntry[] }
const { projects } = Astro.props;
const rows = [...projects].sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);
---
<section class="work" aria-labelledby="work-h" id="work">
  <h2 id="work-h" class="display section-h">Work</h2>
  <slot />
  <ol class="rows">
    {rows.map((p) => (
      <li class:list={['work-row', { 'has-block': p.data.shots.length > 0 }]} data-work={p.id} data-peek={p.data.shots.length ? p.id : undefined}>
        <a href={`/work/${p.id}/`}>
          <span class="title display"><span class="tw">{p.data.title.split(' ').map((w, i) => (<><span class="tx"><span class="tx-in" style={`--w:${i}`}>{w}</span></span>{' '}</>))}</span><span class="go arrow" aria-hidden="true"><Icon name="arrow-right" /></span><span class="mk"><ProjectMark kind={p.data.mark} icon={p.data.icon} /></span></span>
          <span class="about">
            <span class="ln line"><span class="ln-in" style="--l:0">{p.data.summary}</span></span>
            <span class="ln meta"><span class="ln-in" style="--l:1">{p.data.scope}, {p.data.year}. {p.data.stack.join(', ')}.</span></span>
          </span>
          {p.data.shots.length > 0 && (
            <Image class="thumb" src={p.data.shots[0].src} alt="" widths={[480, 720]} sizes="(min-width: 700px) 640px, 92vw" loading="lazy" decoding="async" />
          )}
        </a>
      </li>
    ))}
  </ol>
  <div class="peek" aria-hidden="true">
    {rows.filter((p) => p.data.shots.length).map((p) => (
      <Image class="peek-img" data-for={p.id} src={p.data.shots[0].src} alt="" height={320} densities={[1, 2]} loading="lazy" decoding="async" />
    ))}
  </div>
</section>

<script>
  // Mouse only: the preview trails the cursor with a light ease. Moved with
  // transform, faded with opacity; no listener runs on touch devices.
  const fine = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)');
  const peek = document.querySelector<HTMLElement>('.peek');
  if (peek && fine.matches) {
    const imgs = [...peek.querySelectorAll<HTMLElement>('.peek-img')];
    let tx = 0, ty = 0, x = 0, y = 0, raf = 0, shown = false;
    const place = () => {
      x += (tx - x) * 0.2;
      y += (ty - y) * 0.2;
      peek.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(place) : 0;
    };
    const aim = (e: PointerEvent) => {
      const w = peek.offsetWidth, h = peek.offsetHeight;
      tx = Math.min(e.clientX + 48, innerWidth - w - 16);
      ty = Math.max(16, Math.min(e.clientY - h / 2, innerHeight - h - 16));
      if (!shown) { x = tx; y = ty; }
      if (!raf) raf = requestAnimationFrame(place);
    };
    document.querySelectorAll<HTMLElement>('.work-row[data-peek]').forEach((row) => {
      const id = row.dataset.peek;
      row.addEventListener('pointerenter', (e) => {
        imgs.forEach((im) => im.classList.toggle('on', im.dataset.for === id));
        aim(e);
        shown = true;
        peek.classList.add('show');
      });
      row.addEventListener('pointermove', aim);
      row.addEventListener('pointerleave', () => {
        shown = false;
        peek.classList.remove('show');
      });
    });
  }
</script>

<script>
  // One-time per-row reveal; never re-animates.
  const rows = document.querySelectorAll<HTMLElement>('.js-reveal .work-row');
  if (rows.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0 },
    );
    rows.forEach((r) => io.observe(r));
  } else rows.forEach((r) => r.classList.add('in'));
</script>

<style>
  .section-h {
    font-size: var(--step-4);
    color: var(--c-ink);
    margin-bottom: var(--space-6);
  }
  /* On phones a project with screenshots appears as a coloured block above
     (FeaturedWork, phoneOnly) instead of a row. */
  @media (max-width: 699px) {
    .has-block {
      display: none;
    }
  }
  .rows {
    list-style: none;
    border-top: 1px solid var(--c-ink);
  }
  .work-row {
    border-bottom: 1px solid var(--c-rule);
  }
  .work-row a {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-7) var(--space-8);
    color: inherit;
    text-decoration: none;
  }
  .title {
    font-size: var(--step-6);
    color: var(--c-display);
    display: flex;
    align-items: baseline;
    gap: 0.25em;
    padding-bottom: 0.06em;
  }
  .mk {
    margin-left: auto;
    align-self: center;
    --mark: 48px;
  }
  @media (min-width: 1024px) {
    .mk {
      --mark: 88px;
    }
  }
  .go {
    font-size: 0.5em;
    font-stretch: 100%;
    font-weight: 400;
  }
  .about {
    display: grid;
    gap: var(--space-2);
    max-width: 46ch;
  }
  .line {
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .meta {
    font-family: var(--font-data);
    font-size: 0.92em;
    letter-spacing: -0.01em;
    color: var(--c-ink-2);
  }
  /* Touch and narrow screens: a cropped peek of the first screenshot under each
     row (the mouse preview below is hover-only, so phones would see no work). */
  .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-2);
    box-shadow: 0 0 0 1px var(--c-rule);
    margin-top: var(--space-3);
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    .thumb {
      display: none;
    }
  }
  .work-row a:focus-visible {
    outline-offset: 4px;
  }
  /* Touch press feedback: hover is fine-pointer only. */
  .work-row a:active {
    opacity: 0.6;
  }

  @media (min-width: 1024px) {
    .work-row a {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: var(--gutter);
      align-items: end;
      padding-block: var(--space-8);
    }
    .about {
      padding-bottom: 0.6em;
    }
  }

  /* Reveal, once per row as it enters view (script above adds .in): the row
     rule draws left to right and the mark pops in. The title and summary stay
     put (text does not animate on scroll). Transform and opacity only. Hidden only under
     .js-reveal, so no-JS and reduced motion show everything. */
  .tw {
    display: block;
    /* Tight box so the title can morph into the case-study headline. */
    width: fit-content;
  }
  .tx,
  .ln {
    display: inline-block;
    vertical-align: bottom;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .ln {
    display: block;
  }
  .tx-in,
  .ln-in {
    display: block;
  }
  .work-row {
    position: relative;
  }
  .work-row::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px 0;
    height: 3px;
    background: var(--c-ink);
    transform-origin: left;
  }
  .mk {
    transform-origin: center;
  }
  :global(.js-reveal) .work-row:not(.in)::after {
    transform: scaleX(0);
  }
  :global(.js-reveal) .work-row:not(.in) .mk {
    transform: scale(0.4) rotate(-25deg);
  }
  :global(.js-reveal) .work-row .mk {
    transition: transform 900ms var(--ease-enter) 500ms;
  }
  :global(.js-reveal) .work-row::after {
    transition: transform 1100ms cubic-bezier(0.65, 0, 0.2, 1);
  }

  /* Cursor preview: fixed, out of flow, never takes the pointer. Shown only
     where the script above runs (mouse, wide screens). */
  .peek {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    .peek {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 5;
      height: 320px;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--dur-base) var(--ease-enter);
      will-change: transform;
    }
    .peek.show {
      opacity: 1;
    }
    .peek :global(.peek-img) {
      position: absolute;
      top: 0;
      left: 0;
      height: 320px;
      width: auto;
      max-width: 560px;
      object-fit: cover;
      border-radius: var(--radius-2);
      box-shadow: 0 0 0 1px var(--c-rule);
      opacity: 0;
    }
    .peek :global(.peek-img.on) {
      position: relative;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .peek {
      transition: none;
    }
  }

  /* Fine pointers: the title slides in and the arrow arrives. Touch keeps
     the arrow visible at rest, so the row still reads as a link. */
  @media (hover: hover) and (pointer: fine) {
    .title,
    .go {
      transition:
        transform var(--dur-base) var(--ease-enter),
        opacity var(--dur-base) var(--ease-enter);
    }
    .go {
      opacity: 0;
      transform: translateX(-0.3em);
    }
    .work-row a:hover .title {
      transform: translateX(12px);
    }
    .work-row {
      transition: opacity var(--dur-base) var(--ease-enter);
    }
    .rows:has(a:hover) .work-row:not(:hover),
    .rows:has(a:focus-visible) .work-row:not(:has(a:focus-visible)) {
      opacity: 0.4;
    }
    .work-row a:hover .go {
      color: var(--c-signal);
      opacity: 1;
      transform: none;
    }
  }
</style>
