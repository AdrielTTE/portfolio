---
// A small flat mark that stands for a project's shape of work: bars for a
// tracker's charts, overlapping cards for a planner. Decorative, so hidden from
// assistive tech. Sized by --mark (default 64px) so each place can scale it.
// When the project has its real app icon, that shows instead of the flat mark.
import { Image } from 'astro:assets';
interface Props { kind?: 'bars' | 'cards' | 'disc'; icon?: ImageMetadata }
const { kind, icon } = Astro.props;
---
{icon ? (
  <Image class="app-icon" src={icon} width={192} height={192} alt="" aria-hidden="true" />
) : kind && (
  <span class:list={['mark', kind]} aria-hidden="true">
    {kind === 'bars' && (<><i></i><i></i><i></i></>)}
    {kind === 'cards' && (<><i></i><i></i></>)}
    {kind === 'disc' && <i></i>}
  </span>
)}

<style>
  .app-icon {
    display: block;
    width: var(--mark, 64px);
    height: var(--mark, 64px);
    border-radius: 22%;
    /* The ring defaults to the page rule; on a project's dark stage the
       parent sets a light one, since an icon whose own background is close to
       the stage colour would otherwise melt into it. */
    box-shadow: 0 0 0 var(--mark-ring-w, 1px) var(--mark-ring, var(--c-rule));
  }
  .mark {
    --m: var(--mark, 64px);
    position: relative;
    display: inline-block;
    flex: none;
    width: var(--m);
    height: var(--m);
    color: var(--c-display);
  }
  .bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: calc(var(--m) * 0.1);
  }
  .bars i {
    display: block;
    height: calc(var(--m) * 0.13);
    background: currentColor;
  }
  .bars i:nth-child(1) {
    width: 100%;
  }
  .bars i:nth-child(2) {
    width: 66%;
  }
  .bars i:nth-child(3) {
    width: 82%;
  }
  .cards i {
    position: absolute;
    width: 58%;
    height: 72%;
    border: calc(var(--m) * 0.04) solid currentColor;
    background: var(--c-bg);
  }
  .cards i:nth-child(1) {
    left: 8%;
    top: 6%;
  }
  .cards i:nth-child(2) {
    left: 34%;
    top: 22%;
    background: currentColor;
  }
  .disc i {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: currentColor;
  }
</style>
