---
// docs/design-spec.md §5.1.3. `feature` sits in the 4-slot rhythm; `archive`
// is a plain grid tile with `content-visibility: auto` for scale.
import type { CollectionEntry } from 'astro:content';
import Cover from '../covers/Cover.astro';
import { numberFor } from '../lib/work';

interface Props {
  project: CollectionEntry<'work'>;
  variant: 'feature' | 'archive';
  slotIndex?: 1 | 2 | 3 | 4;
  index?: number;
}
const { project, variant, slotIndex, index = 0 } = Astro.props;
const { title, scope, stack, year } = project.data;
const mobileAspect = variant === 'feature' && index % 2 === 1 ? '4 / 5' : undefined;
const rowDelay = variant === 'feature' && (slotIndex === 2 || slotIndex === 4) ? '90ms' : undefined;
const styleParts = [
  mobileAspect ? `--tile-aspect-360:${mobileAspect}` : '',
  rowDelay ? `--row-delay:${rowDelay}` : '',
]
  .filter(Boolean)
  .join(';');
---
<a
  href={`/work/${project.id}`}
  class={`tile tile--${variant}`}
  data-slot={variant === 'feature' ? slotIndex : undefined}
  data-scope={scope}
  data-year={year}
  data-order={numberFor(project)}
  data-index={index}
  style={styleParts || undefined}
>
  <Cover project={project} variant={variant} slotIndex={slotIndex} />
  <span class="caption">
    <span class="line-1">
      <span class="name">{title} <span class="arrow">→</span></span>
      <span class="year">{year}</span>
    </span>
    {variant === 'feature' && <span class="line-2">{scope} · {stack.join(', ')}</span>}
  </span>
</a>

<style>
  .tile {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .tile--feature {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .tile--feature[data-slot='1'] { grid-column: 1 / span 5; }
    .tile--feature[data-slot='2'] { grid-column: 6 / span 3; align-self: end; }
    .tile--feature[data-slot='3'] { grid-column: 1 / span 8; margin-top: var(--space-9); }
    .tile--feature[data-slot='4'] { grid-column: 3 / span 6; margin-top: var(--space-10); }
  }
  @media (min-width: 1024px) {
    .tile--feature[data-slot='1'] { grid-column: 1 / span 7; margin-top: 0; }
    .tile--feature[data-slot='2'] { grid-column: 9 / span 4; align-self: end; margin-top: 0; }
    .tile--feature[data-slot='3'] { grid-column: 2 / span 5; margin-top: var(--space-9); }
    .tile--feature[data-slot='4'] { grid-column: 7 / span 6; margin-top: var(--space-10); }
  }
  .tile--archive {
    grid-column: span 4;
    content-visibility: auto;
    contain-intrinsic-size: auto 320px;
  }
  @media (min-width: 768px) {
    .tile--archive {
      grid-column: span 8;
    }
  }
  @media (min-width: 1024px) {
    .tile--archive {
      grid-column: span 3;
    }
  }

  .caption {
    display: block;
    margin-top: 12px;
  }
  .line-1 {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .name {
    font-weight: 500;
    font-size: var(--step-0);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .tile:hover .name .arrow {
      translate: 4px 0;
      transition: translate var(--dur-fast) var(--ease-enter);
    }
  }
  .year {
    font-family: var(--font-mono);
    color: var(--c-ink-2);
    font-size: var(--step--1);
  }
  .line-2 {
    display: block;
    color: var(--c-ink-2);
    font-size: var(--step-0);
    margin-top: 2px;
  }
  @media (min-width: 768px) {
    .line-2 {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
