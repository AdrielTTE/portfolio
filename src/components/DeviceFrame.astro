---
// Screenshot in a phone or browser frame. Placeholder (real UI strings, no
// imagery) when a project has no shots yet. docs/design-addendum.md §6.5.
import { Image } from 'astro:assets';
import type { WorkEntry } from '../lib/work';

interface Props { project: WorkEntry; variant: 'hero' | 'lead' | 'thumb'; eager?: boolean }
const { project, variant, eager = false } = Astro.props;
const { device, shots, title, summary, accent, live } = project.data;
const shot = shots[0];
const widths = variant === 'thumb' ? [240, 480] : [640, 960, 1280, 1920];
const host = live ? new URL(live).host : 'localhost:3000';
---
<figure
  class={`frame frame--${device} frame--${variant}`}
  data-shot-slug={project.id}
  data-variant={variant}
  style={[accent && `--frame-tint:${accent}`, variant === 'hero' && 'view-transition-name: shot'].filter(Boolean).join(';')}
>
  <div class="bezel" aria-hidden={shot ? undefined : 'true'}>
    {device === 'browser' && <div class="chrome">{host}</div>}
    <div class="screen">
      {shot ? (
        <Image
          src={shot.src}
          alt={shot.alt}
          widths={widths}
          sizes={variant === 'thumb' ? '240px' : '(min-width: 1024px) 60vw, 100vw'}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
        />
      ) : (
        <div class="placeholder">
          <strong>{title}</strong>
          <span>{summary}</span>
        </div>
      )}
    </div>
  </div>
</figure>

<style>
  /* Backdrop: docs/design-addendum.md §6.5. Fixed aspect ratios so there is
     zero CLS; the device bezel sits inside and is cropped by the backdrop's
     own overflow, a static clip that never animates. */
  .frame {
    margin: 0;
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background: var(--frame-tint, var(--c-bg-2));
  }
  .frame--hero {
    aspect-ratio: 16 / 9;
  }
  @media (max-width: 599px) {
    .frame--hero {
      aspect-ratio: 4 / 5;
    }
  }
  .frame--lead {
    aspect-ratio: 16 / 10;
  }
  .frame--thumb {
    aspect-ratio: 4 / 3;
  }

  .bezel {
    position: absolute;
    border: 1px solid var(--c-rule);
    background: var(--c-bg);
    overflow: hidden;
  }
  .frame--browser .bezel {
    width: 88%;
    left: 6%;
    top: 8%;
    border-radius: 8px;
  }
  .frame--phone .bezel {
    height: 88%;
    aspect-ratio: 9 / 19.5;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    border-radius: 28px;
    padding: 6px;
  }

  .chrome {
    height: 32px;
    display: flex;
    align-items: center;
    padding-inline: 12px;
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-rule);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }

  .screen {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .frame--phone .screen {
    aspect-ratio: auto;
    height: 100%;
    border-radius: 22px;
  }
  .screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding: 24px;
    background: var(--c-bg);
    font-family: var(--font-device);
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
  .placeholder strong {
    color: var(--c-ink);
    font-size: var(--step-1);
    font-family: var(--font-device);
  }
  .frame--thumb .placeholder {
    padding: 6px;
  }
  .frame--thumb .placeholder span {
    display: none;
  }
</style>
