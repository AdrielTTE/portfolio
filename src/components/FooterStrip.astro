---
// Latest work as plain plate blocks (no cover composition, so it's cheap
// even with a large archive). docs/design-spec.md §5.6.
import type { CollectionEntry } from 'astro:content';
import { plateFor, onPlate } from '../lib/plate';
import { sortByOrder } from '../lib/work';

interface Props {
  projects: CollectionEntry<'work'>[];
  currentSlug?: string;
}
const { projects, currentSlug } = Astro.props;
const latest = sortByOrder(projects).reverse().slice(0, 8);
---
<div class="footer-strip">
  <h2>Latest work</h2>
  <div class="strip-scroller">
    <div class="blocks">
      {
        latest.map((project) => {
          const plate = plateFor(project);
          const isCurrent = project.id === currentSlug;
          return (
            <a
              href={`/work/${project.id}`}
              class="block"
              style={`--plate:${plate};--c-on-plate:${onPlate(plate)}`}
              aria-current={isCurrent ? 'page' : undefined}
            >
              <span class="block-name">{project.data.title}</span>
            </a>
          );
        })
      }
    </div>
  </div>
  <a href="/#work" class="all-work">All work →</a>
</div>

<style>
  .footer-strip h2 {
    font-weight: 500;
    font-size: var(--step-0);
    margin-bottom: 16px;
  }
  .strip-scroller {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .strip-scroller::-webkit-scrollbar {
    display: none;
  }
  .blocks {
    display: flex;
    gap: 12px;
  }
  .block {
    flex: 0 0 42%;
    aspect-ratio: 4 / 3;
    background: var(--plate);
    color: var(--c-on-plate);
    position: relative;
    text-decoration: none;
    scroll-snap-align: start;
  }
  .strip-scroller {
    scroll-snap-type: x mandatory;
  }
  .block[aria-current='page'] {
    outline: 2px solid var(--c-ink);
    outline-offset: 3px;
  }
  .block-name {
    position: absolute;
    left: 10px;
    bottom: 10px;
    right: 10px;
    font-weight: 500;
    font-size: 14px;
  }
  .all-work {
    display: inline-block;
    margin-top: 16px;
    font-weight: 500;
  }

  @media (min-width: 600px) {
    .blocks {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
    .block {
      flex: none;
    }
  }
  @media (min-width: 1024px) {
    .blocks {
      grid-template-columns: repeat(8, 1fr);
    }
  }
</style>
