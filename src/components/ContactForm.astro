---
// docs/design-spec.md §5.4. Works without JS (plain POST to Formspree, with
// native browser validation); with JS, the script turns native validation off,
// submits via fetch and swaps in inline states. Every named field, including
// the optional project type and timeline, goes to Formspree as-is.
import Button from './Button.astro';
import { site } from '../data/site';

interface Props {
  endpoint: string;
  subject?: string;
}
const { endpoint, subject = 'Portfolio contact' } = Astro.props;
const projectTypes = ['Web app', 'API or database', 'Mobile app', 'Website', 'Not sure'];
// Shown under "Message sent." after a successful submit.
const successNote = `${site.replyTime} Look out for an email from ${site.email}, usually with a few questions or a time for a short call.`;
---
<form class="contact-form" id="contact-form" action={endpoint} method="POST" data-success-note={successNote}>
  <div class="field">
    <label for="cf-name">Name</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="cf-name-error" />
    <p class="field-error" id="cf-name-error" hidden>Enter your name.</p>
  </div>

  <div class="field">
    <label for="cf-email">Email</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required aria-describedby="cf-email-error" />
    <p class="field-error" id="cf-email-error" hidden>Enter a valid email address.</p>
  </div>

  <fieldset class="field choice">
    <legend>What do you need? <span class="optional">Optional</span></legend>
    <div class="options">
      {projectTypes.map((type, i) => (
        <label class="option" for={`cf-type-${i}`}>
          <input id={`cf-type-${i}`} type="radio" name="project_type" value={type} />
          <span>{type}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="field">
    <label for="cf-timeline">Timeline <span class="optional">Optional</span></label>
    <input id="cf-timeline" name="timeline" type="text" autocomplete="off" aria-describedby="cf-timeline-hint" />
    <p class="hint" id="cf-timeline-hint">A launch date, a rough month, or "no fixed date".</p>
  </div>

  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="8" required minlength="10" aria-describedby="cf-message-error"></textarea>
    <p class="field-error" id="cf-message-error" hidden>Message must be at least 10 characters.</p>
  </div>

  <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="_subject" value={subject} />

  <p class="form-error" id="form-error" role="alert" tabindex="-1" hidden></p>

  <Button as="button" type="submit" variant="primary" class="submit-btn">
    <span>Send message</span>
  </Button>
</form>

<script src="../scripts/contact-form.ts"></script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  label,
  legend {
    font-weight: 500;
    font-size: var(--step-0);
  }
  legend {
    padding: 0;
    margin-bottom: 8px;
  }
  .optional {
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--c-ink-2);
    margin-left: 6px;
  }
  .hint {
    margin: 0;
    font-size: var(--step--1);
    color: var(--c-ink-2);
  }
  input:not([type='radio']),
  textarea {
    height: 48px;
    padding: 12px;
    background: var(--c-bg);
    border: 1px solid var(--c-ink-2);
    border-radius: 2px;
    font-size: 16px;
    color: var(--c-ink);
  }
  textarea {
    height: auto;
    resize: vertical;
  }
  @media (hover: hover) and (pointer: fine) {
    input:not([type='radio']):hover,
    textarea:hover {
      border-color: var(--c-ink);
    }
  }
  input:invalid[data-touched],
  textarea:invalid[data-touched] {
    border-color: var(--c-error);
    border-width: 2px;
  }

  /* Project type: native radios in bordered rows (same field border, 48px
     tall so each is a full touch target), wrapping two-up on narrow screens. */
  .options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .option {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding-inline: 12px;
    border: 1px solid var(--c-ink-2);
    border-radius: 2px;
    font-weight: 400;
    cursor: pointer;
  }
  .option input {
    width: 18px;
    height: 18px;
    margin: 0;
    flex: none;
    accent-color: var(--c-accent);
  }
  .option:has(input:checked) {
    border-color: var(--c-accent);
    box-shadow: inset 0 0 0 1px var(--c-accent);
  }
  .option:has(input:focus-visible) {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .option:hover {
      border-color: var(--c-ink);
    }
  }
  @media (min-width: 600px) {
    .options {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .options {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .field-error {
    color: var(--c-error);
    font-size: var(--step-0);
    margin: 0;
  }
  .form-error {
    color: var(--c-error);
    margin: 0;
    scroll-margin-block: calc(var(--header-h) + var(--space-5));
  }
  .form-error:focus {
    outline: none;
  }
  .submit-btn {
    width: 100%;
  }
  @media (min-width: 768px) {
    .submit-btn {
      width: auto;
      align-self: flex-start;
    }
  }
  /* Built by contact-form.ts after the form is removed, so not scoped. */
  :global(.form-success h2) {
    font-size: var(--step-2);
    font-weight: 500;
  }
  :global(.form-success p) {
    margin-top: 12px;
    font-size: var(--step-1);
    max-width: 48ch;
  }
</style>
